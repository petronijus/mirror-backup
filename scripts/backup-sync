#!/usr/bin/env bash
# backup-sync — rsync wrapper with progress tracking and desktop notifications
# Usage: backup-sync <job-name> <src> <dst> [exclude-file] [archive-days]
#
# Where things live (src/backup_monitor/paths.py resolves the same paths):
#   <dst>/.mirror-backup/          status.json, history.jsonl, backup.log, deferred
#       The job's state travels with its mirror: every machine or OS that
#       mounts the destination sees the same status and history, so a run done
#       on one of them counts on the others.
#   $XDG_RUNTIME_DIR/backup-sync/  queue.lock, <job>.pid, <job>.progress
#       Meaningful for this boot only.
#
# A run cut short by suspend, shutdown or logout is postponed, not failed:
# suspend stops rsync and runs it again after wake, shutdown/logout leave a
# `deferred` marker that `mirror-backup resume` (mirror-backup-resume.service,
# once per user-manager start) turns back into a run — on whichever machine
# mounts the destination next.

set -euo pipefail

# Installs up to 0.5 called this from mirror-backup-resume.service. Only the
# app knows every job's destination, so the work moved there.
if [[ "${1:-}" == "--resume-deferred" ]]; then
    if command -v mirror-backup >/dev/null; then
        exec mirror-backup resume
    fi
    echo "backup-sync: --resume-deferred moved to 'mirror-backup resume', which is not installed" >&2
    exit 1
fi

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/backup-sync"
mkdir -p "$RUNTIME_DIR"

JOB_NAME="${1:?Usage: backup-sync <job-name> <src> <dst> [exclude-file] [archive-days]}"
SRC="${2:?Missing source path}"
DST="${3:?Missing destination path}"
EXCLUDE_FILE="${4:-}"
ARCHIVE_DAYS="${5:-0}"

DST_DIR="${DST%/}"
[[ -n "$DST_DIR" ]] || DST_DIR=/
STATE_DIR="$DST_DIR/.mirror-backup"
STATUS_FILE="$STATE_DIR/status.json"
HISTORY_FILE="$STATE_DIR/history.jsonl"
LOG_FILE="$STATE_DIR/backup.log"
DEFERRED_FILE="$STATE_DIR/deferred"
PID_FILE="$RUNTIME_DIR/$JOB_NAME.pid"
PROGRESS_FILE="$RUNTIME_DIR/$JOB_NAME.progress"
LOCK_FILE="$RUNTIME_DIR/queue.lock"
STATE_OK=0         # 1 once $STATE_DIR exists — nothing is written to $DST before

HOST="${HOSTNAME:-$(uname -n)}"
BOOT_ID="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"

# logind endpoint the suspend guard listens to. Overridable only so the
# suspend path can be exercised against a fake logind on the session bus.
LOGIND_BUS="${BACKUP_SYNC_LOGIND_BUS:-system}"
LOGIND_NAME="${BACKUP_SYNC_LOGIND_NAME:-org.freedesktop.login1}"
RSYNC_STOP_GRACE="${BACKUP_SYNC_STOP_GRACE:-10}"   # seconds between SIGTERM and SIGKILL

RSYNC_PID=""
PRUNE_PID=""
FLOCK_PID=""
INHIBIT_PID=""
SLEEP_GUARD=0      # 1 while the logind signal monitor (coprocess SLEEP_MON) runs
SLEEP_EVENT=""     # "start" / "end" after wait_tick saw PrepareForSleep
DEFERRED=0
DEFER_REASON=""    # "suspend" or "shutdown"
WAS_PAUSED=0       # rsync was paused when a suspend stopped it
LAST_PCT=0
LAST_SPEED=""
LAST_ETA=""
CURRENT_FILE=""
FILES_XFRD=0
FILES_TOTAL=0
FILES_REMAINING=0
ERROR_MSG=""
SCAN_READ=""
FINISHED=0
IS_PAUSED=0
CONSECUTIVE_FAILURES=0
# Where the run is — see the progress filter below for the phases.
PHASE=""
PHASE_DONE=0
PHASE_TOTAL=0      # 0 = not known
PHASE_ESTIMATED=0  # 1 when PHASE_TOTAL is the previous run's count
PHASE_SEEN_EPOCH=0 # first sighting of the phase and its count then, for the ETA
PHASE_SEEN_DONE=0
COMPARED=0         # 1 once rsync compares files (state "running" from then on)
DIRS_SEEN=0
EST_FILES=0        # the previous successful run's file-list size …
EST_DIRS=0         # … and directory count, totals for the phases that have none
TRANSFER_SEQ=""    # rsync's transfer-progress line counter …
TRANSFER_EPOCH=0   # … and when it last moved: the speed is shown while it is fresh
PROGRESS_EOF=0
SUGGESTED_EXCLUDES_JSON="[]"
START_TIME="$(date -Iseconds)"
START_EPOCH="$(date +%s)"

HISTORY_KEEP="${BACKUP_SYNC_HISTORY_KEEP:-200}"
FAILURE_STREAK_THRESHOLD="${BACKUP_SYNC_STREAK_THRESHOLD:-3}"

# --- helpers ---

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

format_bytes() {
    local bytes=$1
    if (( bytes >= 1073741824 )); then
        local whole=$((bytes / 1073741824))
        local frac=$(( (bytes % 1073741824) * 10 / 1073741824 ))
        printf '%d.%d GB' "$whole" "$frac"
    elif (( bytes >= 1048576 )); then
        local whole=$((bytes / 1048576))
        local frac=$(( (bytes % 1048576) * 10 / 1048576 ))
        printf '%d.%d MB' "$whole" "$frac"
    elif (( bytes >= 1024 )); then
        printf '%d KB' $((bytes / 1024))
    else
        printf '%d B' "$bytes"
    fi
}

write_status() {
    local state="$1"
    local escaped_file escaped_error estimated=false
    (( STATE_OK )) || return 0
    (( PHASE_ESTIMATED )) && estimated=true
    escaped_file=$(json_escape "${CURRENT_FILE:-}")
    escaped_error=$(json_escape "${ERROR_MSG:-}")
    cat > "${STATUS_FILE}.tmp" <<-JEOF
{
  "job": "$(json_escape "$JOB_NAME")",
  "state": "$state",
  "progress": ${LAST_PCT:-0},
  "speed": "${LAST_SPEED:-}",
  "eta": "${LAST_ETA:-}",
  "current_file": "$escaped_file",
  "files_transferred": ${FILES_XFRD:-0},
  "files_total": ${FILES_TOTAL:-0},
  "files_remaining": ${FILES_REMAINING:-0},
  "phase": "${PHASE:-}",
  "phase_done": ${PHASE_DONE:-0},
  "phase_total": ${PHASE_TOTAL:-0},
  "phase_estimated": $estimated,
  "pid": $$,
  "rsync_pid": ${RSYNC_PID:-0},
  "started": "$START_TIME",
  "updated": "$(date -Iseconds)",
  "scan_read": "${SCAN_READ:-}",
  "src": "$(json_escape "$SRC")",
  "dst": "$(json_escape "$DST")",
  "host": "$(json_escape "$HOST")",
  "boot_id": "$BOOT_ID",
  "error": "$escaped_error",
  "deferred_reason": "${DEFER_REASON:-}",
  "consecutive_failures": ${CONSECUTIVE_FAILURES:-0},
  "suggested_excludes": ${SUGGESTED_EXCLUDES_JSON:-[]}
}
JEOF
    mv -f "${STATUS_FILE}.tmp" "$STATUS_FILE"
}

# notify <summary> <body> [urgency] [expire_ms]
# urgency: 0=low, 1=normal (default), 2=critical
# expire_ms: 0 = never auto-dismiss (sticky), default 5000
notify() {
    local urgency="${3:-1}"
    local expire="${4:-5000}"
    gdbus call --session \
        --dest=org.freedesktop.Notifications \
        --object-path=/org/freedesktop/Notifications \
        --method=org.freedesktop.Notifications.Notify \
        "Backup Sync" 0 "drive-harddisk" "$1" "$2" '[]' \
        "{'urgency': <byte $urgency>}" "$expire" \
        >/dev/null 2>&1 || true
}

# Count trailing failures in the history JSONL (newest entries first walk-back).
# Stops at the first successful entry. Echoes the streak count.
compute_failure_streak() {
    local file="$1"
    [[ -f "$file" ]] || { echo 0; return; }
    awk '
        { lines[NR] = $0 }
        END {
            streak = 0
            for (i = NR; i >= 1; i--) {
                if (lines[i] ~ /"exit_code":[[:space:]]*0,/) break
                if (lines[i] ~ /"exit_code":[[:space:]]*[0-9]+,/) streak++
            }
            print streak
        }
    ' "$file"
}

# Trim history file to last N entries (atomic via temp + rename).
rotate_history() {
    local file="$1" keep="$2"
    [[ -f "$file" ]] || return 0
    local lines
    lines=$(wc -l < "$file" 2>/dev/null) || return 0
    if (( lines > keep )); then
        tail -n "$keep" "$file" > "${file}.tmp" && mv -f "${file}.tmp" "$file"
    fi
}

# Scan the CURRENT run's log section for "Permission denied" rsync errors and
# emit deduped top-level paths (relative to SRC) that the user can add to the
# exclude file. Looks only at lines after the `=== <START_TIME> ===` marker so
# a previously-resolved error doesn't keep showing up.
# Output: one path per line on stdout (empty if no errors).
# Implemented as a single awk so empty matches don't trip pipefail+set -e.
suggest_excludes_from_log() {
    [[ -f "$LOG_FILE" ]] || return 0
    local src_clean="${SRC%/}"
    local marker="=== ${START_TIME} ==="
    awk -v marker="$marker" -v src="$src_clean" '
        BEGIN { srclen = length(src) + 1 }
        !found {
            if (index($0, marker) == 1) found = 1
            next
        }
        /Permission denied/ {
            if (match($0, /"[^"]+"/)) {
                path = substr($0, RSTART + 1, RLENGTH - 2)
                if (substr(path, 1, srclen) == src "/") {
                    rel = substr(path, srclen + 1)
                    slash = index(rel, "/")
                    top = (slash > 0) ? substr(rel, 1, slash - 1) : rel
                    if (top != "") seen[top] = 1
                }
            }
        }
        END { for (s in seen) print s }
    ' "$LOG_FILE" | sort
}

# Build a JSON array literal from newline-delimited stdin, e.g. "a\nb\n" → ["a","b"]
to_json_array() {
    local first=1 out="["
    while IFS= read -r item; do
        [[ -z "$item" ]] && continue
        local escaped
        escaped=$(json_escape "$item")
        if (( first )); then
            out+="\"$escaped\""
            first=0
        else
            out+=",\"$escaped\""
        fi
    done
    out+="]"
    printf '%s' "$out"
}

# --- progress ---
#
# A run goes through up to three phases, and rsync's own progress line covers
# none of them: it counts bytes copied against the size of everything, so an
# incremental run of a big mirror sits at 0 % from start to end.
#
#   listing   the sender walks the source         --info=flist2: "N files..."
#   deleting  a separate pass over the mirror's   --debug=del2: one
#             directories (--delete-before/after)  "delete_in_dir(dir)" each
#   checking  every entry of the file list is     -ii: one itemize line per
#             compared, and copied when it changed entry, unchanged ones too
#
# The filter below follows that output and appends a snapshot line to
# $PROGRESS_FILE for every message it counts; the status tick reads the last
# one (read_progress). A snapshot per message, not per so many: rsync can go
# quiet for minutes on a slow mount, and the count shown must be the one it
# stopped at. The file starts over every 20000 lines. Counting happens in awk
# because a run names every one of millions of files. Fields are separated by
# the unit separator (\x1f): rsync escapes control characters in the names it
# itemizes, and unlike a tab it keeps empty fields apart when bash reads them.
PROGRESS_AWK='
function dump(eof) {
    if (written++ >= 20000) { close(out); written = 1 }   # reopened, it starts empty
    printf "%s\037%d\037%d\037%d\037%d\037%s\037%d\037%d\037%s\037end\n", \
        phase, done, files_total, dirs, xfr, speed, p2n, eof, current > out
    fflush(out)
}
function enter(p) { phase = p; done = 0; current = ""; dump(0) }
BEGIN { phase = "listing"; dump(0) }
/^ *[0-9]+ files\.\.\.$/ { done = $1 + 0; dump(0); next }
/^[0-9]+ files to consider$/ { files_total = $1 + 0; enter("checking"); next }
/^deleting in / { enter("deleting"); next }
/^delete_in_dir\(/ {
    if (phase != "deleting") next   # --delete-during: part of the comparison
    done++
    current = substr($0, 15, length($0) - 15)
    dump(0)
    next
}
/^[<>ch.][fdLDS]......... / {
    if (phase != "checking") enter("checking")
    done++
    if (substr($0, 2, 1) == "d") dirs++
    current = substr($0, 13)
    if (substr($0, 2, 1) == "L") sub(/ -> .*$/, "", current)
    dump(0)
    next
}
/^ +[0-9][^ ]* +[0-9]+% / {
    speed = $3; p2n++
    if (match($0, /xfr#[0-9]+/)) xfr = substr($0, RSTART + 4, RLENGTH - 4) + 0
    dump(0)
    next
}
END { dump(1) }
'

# mawk reads a pipe in whole blocks unless it runs interactive, which would
# hold the snapshot back by thousands of lines; gawk passes lines on as they come.
PROGRESS_FILTER=(awk)
case "$(awk -W version 2>&1)" in
    mawk*) PROGRESS_FILTER=(awk -W interactive) ;;
esac
PROGRESS_FILTER+=(-v "out=$PROGRESS_FILE" "$PROGRESS_AWK")

# The filter's last snapshot into the status variables. Returns 1 while there
# is none yet, or when the file was caught starting over or mid-line.
read_progress() {
    local line phase done files_total dirs xfr speed p2n eof current end
    local now permille left
    line=$(tail -n 1 "$PROGRESS_FILE" 2>/dev/null) || return 1
    IFS=$'\x1f' read -r phase done files_total dirs xfr speed p2n eof current end <<< "$line"
    [[ "$end" == end ]] || return 1
    printf -v now '%(%s)T' -1

    if [[ "$phase" != "$PHASE" ]]; then
        PHASE=$phase
        PHASE_SEEN_EPOCH=$now
        PHASE_SEEN_DONE=$done
    fi
    PHASE_DONE=$done
    FILES_TOTAL=$files_total
    FILES_XFRD=$xfr
    DIRS_SEEN=$dirs
    CURRENT_FILE=$current
    PROGRESS_EOF=$eof
    [[ "$PHASE" == checking ]] && COMPARED=1

    PHASE_ESTIMATED=0
    case "$PHASE" in
        listing)
            PHASE_TOTAL=$EST_FILES PHASE_ESTIMATED=1 ;;
        deleting)
            # After the comparison (--delete-after) this run has counted the
            # directories itself; before it, the previous run's count stands in.
            if (( COMPARED && DIRS_SEEN )); then
                PHASE_TOTAL=$DIRS_SEEN
            else
                PHASE_TOTAL=$EST_DIRS PHASE_ESTIMATED=1
            fi ;;
        checking)
            PHASE_TOTAL=$FILES_TOTAL
            FILES_REMAINING=$(( FILES_TOTAL > PHASE_DONE ? FILES_TOTAL - PHASE_DONE : 0 )) ;;
        *)
            PHASE_TOTAL=0 ;;
    esac
    (( PHASE_TOTAL )) || PHASE_ESTIMATED=0

    LAST_PCT=0
    if (( PHASE_TOTAL )); then
        permille=$(( PHASE_DONE * 1000 / PHASE_TOTAL ))
        (( permille <= 1000 )) || permille=1000
        # An estimate is off either way; it never claims the phase finished.
        (( ! PHASE_ESTIMATED || permille <= 990 )) || permille=990
        LAST_PCT="$((permille / 10)).$((permille % 10))"
    fi

    # From the average pace since the phase was first seen (or resumed).
    LAST_ETA=""
    if (( PHASE_TOTAL > PHASE_DONE && PHASE_DONE > PHASE_SEEN_DONE && now - PHASE_SEEN_EPOCH >= 10 )); then
        left=$(( (PHASE_TOTAL - PHASE_DONE) * (now - PHASE_SEEN_EPOCH) / (PHASE_DONE - PHASE_SEEN_DONE) ))
        printf -v LAST_ETA '%d:%02d:%02d' $((left / 3600)) $((left % 3600 / 60)) $((left % 60))
    fi

    # rsync repeats its transfer line only while it copies; a speed from a
    # copy that ended minutes ago would describe nothing.
    if [[ "$p2n" != "$TRANSFER_SEQ" ]]; then
        TRANSFER_SEQ=$p2n
        TRANSFER_EPOCH=$now
    fi
    LAST_SPEED=""
    (( now - TRANSFER_EPOCH > 10 )) || LAST_SPEED=$speed
    return 0
}

# "scanning" until rsync compares files, "running" from then on.
write_active_status() {
    if (( COMPARED )); then
        write_status "running"
    else
        write_status "scanning"
    fi
}

# Totals of the previous successful run, "<files> <dirs>": the source listing
# and a delete pass report no total of their own, and a mirror changes little
# between runs.
previous_totals() {
    [[ -f "$HISTORY_FILE" ]] || return 0
    awk '/"exit_code":[[:space:]]*0[,}]/ && /"files_total":[[:space:]]*[1-9]/ { line = $0 }
        END {
            if (line == "") exit
            f = line; sub(/.*"files_total":[[:space:]]*/, "", f); sub(/[^0-9].*/, "", f)
            d = 0
            if (line ~ /"dirs_total":/) { d = line; sub(/.*"dirs_total":[[:space:]]*/, "", d); sub(/[^0-9].*/, "", d) }
            print f + 0, d + 0
        }' "$HISTORY_FILE"
}

# --- stopping rsync / postponing the run ---

descendants() {
    local child
    for child in $(pgrep -P "$1" 2>/dev/null); do
        echo "$child"
        descendants "$child"
    done
}

# "pid:starttime" for $1 and every process below it. The start time pins the
# identity, so a PID the kernel hands out again is never mistaken for ours.
proc_tree() {
    local pid stat fields
    for pid in "$1" $(descendants "$1"); do
        { stat=$(< "/proc/$pid/stat"); } 2>/dev/null || continue
        read -ra fields <<< "${stat##*) }"   # fields after "(comm) "
        echo "$pid:${fields[19]}"
    done
}

# Any process of a proc_tree snapshot still alive?
tree_alive() {
    local entry pid stat fields
    for entry in "$@"; do
        pid="${entry%%:*}"
        { stat=$(< "/proc/$pid/stat"); } 2>/dev/null || continue
        read -ra fields <<< "${stat##*) }"
        [[ "${fields[19]}" == "${entry#*:}" && "${fields[0]}" != Z ]] && return 0
    done
    return 1
}

# Stop background child $1 and everything it forked (a local rsync transfer
# is a sender, receiver and generator trio), and wait until all of them are
# gone — for a suspend, any survivor could still be inside a FUSE request.
# SIGTERM first so rsync removes its temp files; SIGCONT because a paused
# (SIGSTOPped) rsync cannot act on anything; SIGKILL for whatever is still
# there after the grace period.
stop_tree() {
    local root="$1" entry waited=0
    local -a tree=() pids=()
    [[ -n "$root" ]] && kill -0 "$root" 2>/dev/null || return 0
    mapfile -t tree < <(proc_tree "$root")
    for entry in "${tree[@]}"; do pids+=("${entry%%:*}"); done
    kill -TERM "${pids[@]}" 2>/dev/null || true
    kill -CONT "${pids[@]}" 2>/dev/null || true
    while tree_alive "${tree[@]}" && (( waited < RSYNC_STOP_GRACE * 10 )); do
        sleep 0.1
        waited=$((waited + 1))
    done
    for entry in "${tree[@]}"; do
        tree_alive "$entry" && kill -KILL "${entry%%:*}" 2>/dev/null
    done
    wait "$root" 2>/dev/null || true
}

stop_rsync() {
    stop_tree "$RSYNC_PID"
    IS_PAUSED=0
}

# True while the user's service manager or the whole system is going down —
# shutdown, reboot, or logout of a user without lingering. A SIGTERM arriving
# then is not somebody pressing Stop, so the run is postponed instead of failed.
session_stopping() {
    local scope state
    for scope in --user --system; do
        state=$(timeout 5 systemctl "$scope" is-system-running 2>/dev/null) || true
        [[ "$state" == stopping ]] && return 0
    done
    return 1
}

defer() {
    DEFERRED=1
    DEFER_REASON="$1"
    printf '{"reason": "%s", "since": "%s"}\n' "$1" "$(date -Iseconds)" > "$DEFERRED_FILE"
}

# --- suspend guard ---
#
# rsync blocked inside a FUSE request (NTFS via ntfs-3g, rclone, sshfs …)
# cannot be frozen for suspend: the freezer stops the FUSE daemon as well, the
# request never completes, and after 20 s the kernel aborts the suspend. So
# while rsync runs we hold a logind *delay* inhibitor. logind announces the
# suspend with PrepareForSleep(true) and waits for us; the FUSE daemon is still
# running at that point, the pending request completes, rsync exits, and only
# then is the inhibitor released. After PrepareForSleep(false) the run starts
# over. Needs gdbus and systemd-inhibit; without them the guard stays off.

start_sleep_guard() {
    command -v gdbus >/dev/null && command -v systemd-inhibit >/dev/null \
        && command -v stdbuf >/dev/null || return 0
    coproc SLEEP_MON {
        exec stdbuf -oL gdbus monitor "--$LOGIND_BUS" --dest "$LOGIND_NAME" \
            --object-path /org/freedesktop/login1 2>/dev/null 9>&-
    }
    # gdbus prints the owner line once its match rule is in place; taking the
    # inhibitor any earlier could hold up a suspend whose signal we then miss.
    local line
    while [[ -n "${SLEEP_MON[0]:-}" ]] && IFS= read -r -t 5 -u "${SLEEP_MON[0]}" line; do
        if [[ "$line" == "The name $LOGIND_NAME is owned by "* ]]; then
            SLEEP_GUARD=1
            return 0
        fi
    done
    stop_sleep_guard
}

stop_sleep_guard() {
    release_inhibitor
    if [[ -n "${SLEEP_MON_PID:-}" ]]; then
        kill "$SLEEP_MON_PID" 2>/dev/null || true
        wait "$SLEEP_MON_PID" 2>/dev/null || true
    fi
    SLEEP_GUARD=0
}

acquire_inhibitor() {
    (( SLEEP_GUARD )) && [[ -z "$INHIBIT_PID" ]] || return 0
    systemd-inhibit --what=sleep --mode=delay --who="Mirror Backup" \
        --why="Stopping $JOB_NAME before suspend" sleep infinity 9>&- &
    INHIBIT_PID=$!
}

release_inhibitor() {
    [[ -n "$INHIBIT_PID" ]] || return 0
    kill "$INHIBIT_PID" 2>/dev/null || true
    wait "$INHIBIT_PID" 2>/dev/null || true
    INHIBIT_PID=""
}

# Wait up to $1 seconds (default 2) — the status-refresh tick — and report a
# logind sleep transition in SLEEP_EVENT. A trapped signal does not cut
# `read -t` short, so the tick also bounds how long a stop request waits.
wait_tick() {
    local timeout="${1:-2}" line rc=0
    SLEEP_EVENT=""
    # bash drops the SLEEP_MON array once the coprocess has exited.
    if (( SLEEP_GUARD )) && [[ -z "${SLEEP_MON[0]:-}" ]]; then
        stop_sleep_guard
    fi
    if (( SLEEP_GUARD )); then
        IFS= read -r -t "$timeout" -u "${SLEEP_MON[0]}" line || rc=$?
        if (( rc == 0 )); then
            case "$line" in
                *".PrepareForSleep (true,)"*)  SLEEP_EVENT="start" ;;
                *".PrepareForSleep (false,)"*) SLEEP_EVENT="end" ;;
            esac
            return 0
        fi
        (( rc > 128 )) && return 0    # timed out, or a trapped signal
        stop_sleep_guard              # EOF: the monitor died, fall back to polling
    fi
    sleep "$timeout" &
    wait $! 2>/dev/null || true
}

# Networked source or destination (NFS, SMB, sshfs, rclone …)? Decided from
# the mount table alone, so a server that is still unreachable cannot hang it.
on_network_fs() {
    local path fstype
    for path in "$SRC" "$DST"; do
        fstype=$(findmnt -n -o FSTYPE --target "$path" 2>/dev/null) || continue
        case "$fstype" in
            nfs|nfs4|cifs|smb3|ceph|glusterfs|9p|fuse.sshfs|fuse.rclone|fuse.s3fs|fuse.gcsfuse)
                return 0 ;;
        esac
    done
    return 1
}

# Let the announced suspend proceed and return once the system is back.
wait_for_wake() {
    release_inhibitor
    until [[ "$SLEEP_EVENT" == "end" ]] || (( ! SLEEP_GUARD )); do
        wait_tick   # short ticks keep a Stop during the wait responsive
        handle_signals
    done
    # Right after wake the network is typically still reconnecting.
    if on_network_fs && command -v nm-online >/dev/null; then
        nm-online -q -t 60 || true
    fi
}

# Watch background child $1 until it exits, running $2 every tick. Returns 1
# as soon as a suspend is announced (the caller then stops the child), 0 once
# the child has finished on its own.
supervise() {
    local pid="$1" on_tick="$2"
    while kill -0 "$pid" 2>/dev/null; do
        "$on_tick"
        wait_tick
        handle_signals
        [[ "$SLEEP_EVENT" == "start" ]] && return 1
    done
    return 0
}

no_tick() { :; }

# rsync was cut short by an announced suspend. Even a paused one is stopped:
# rsync's pieces are not guaranteed to be parked outside a FUSE request.
stop_rsync_for_suspend() {
    WAS_PAUSED=$IS_PAUSED
    stop_rsync
    rm -f "$PROGRESS_FILE"
    defer suspend   # the marker survives a machine that never wakes (hibernate, power off)
    write_status "deferred"
    echo "=== $(date -Iseconds) === stopped for suspend, restarts after wake ===" >> "$LOG_FILE"
    notify "⏸ $JOB_NAME" "Stopped for suspend — restarts after wake"
    wait_for_wake
    rm -f "$DEFERRED_FILE"
    DEFERRED=0
    DEFER_REASON=""
}

# --- signal handlers ---
#
# Traps only record what arrived; the work happens at the checkpoints in the
# main flow (handle_signals). A trap runs *inside* whatever builtin it
# interrupted, and when that is `read -t` — the suspend guard's tick — a
# handler that outlives the read's timeout makes bash longjmp into a dead
# stack frame and abort.

TERM_REQUESTED=0
PAUSE_REQUEST=""   # "pause" / "resume", the latest one wins

# The whole rsync tree: stopping only the sender would leave the receiver and
# generator running, and possibly sitting in a FUSE request.
pause_rsync() {
    [[ -n "$RSYNC_PID" ]] && kill -0 "$RSYNC_PID" 2>/dev/null || return 0
    # shellcheck disable=SC2046
    kill -STOP "$RSYNC_PID" $(descendants "$RSYNC_PID") 2>/dev/null || true
    IS_PAUSED=1
    write_status "paused"
}

resume_rsync() {
    [[ -n "$RSYNC_PID" ]] && kill -0 "$RSYNC_PID" 2>/dev/null || return 0
    # shellcheck disable=SC2046
    kill -CONT "$RSYNC_PID" $(descendants "$RSYNC_PID") 2>/dev/null || true
    IS_PAUSED=0
    # The pause says nothing about rsync's pace: the ETA starts measuring anew.
    printf -v PHASE_SEEN_EPOCH '%(%s)T' -1
    PHASE_SEEN_DONE=$PHASE_DONE
    write_active_status
}

handle_signals() {
    if (( TERM_REQUESTED )); then
        on_terminate
    fi
    case "$PAUSE_REQUEST" in
        pause)
            if (( ! IS_PAUSED )) && [[ -n "$RSYNC_PID" ]] && kill -0 "$RSYNC_PID" 2>/dev/null; then
                pause_rsync
                notify "⏸ $JOB_NAME" "Backup paused"
            fi
            ;;
        resume)
            if (( IS_PAUSED )) && [[ -n "$RSYNC_PID" ]] && kill -0 "$RSYNC_PID" 2>/dev/null; then
                resume_rsync
                notify "▶ $JOB_NAME" "Backup resumed"
            fi
            ;;
    esac
    PAUSE_REQUEST=""
}

# SIGTERM / SIGINT / SIGHUP, acted on from handle_signals.
on_terminate() {
    trap '' TERM INT HUP
    if [[ -n "$FLOCK_PID" ]]; then
        kill "$FLOCK_PID" 2>/dev/null || true
    fi
    stop_rsync
    stop_tree "$PRUNE_PID"
    if session_stopping; then
        defer shutdown
    else
        # A deliberate stop cancels the run, including one waiting out a suspend.
        rm -f "$DEFERRED_FILE"
        DEFERRED=0
        DEFER_REASON=""
    fi
    exit 143
}

cleanup() {
    stop_rsync
    stop_tree "$PRUNE_PID"
    stop_sleep_guard
    rm -f "$PID_FILE" "$PROGRESS_FILE" "${PROGRESS_FILE}.tmp" "${STATUS_FILE}.tmp"
    if (( DEFERRED )); then
        write_status "deferred"
        echo "=== $(date -Iseconds) === postponed by $DEFER_REASON, restarts at next start ===" >> "$LOG_FILE"
        # No notification: the desktop session is going away with us.
    elif [[ "$FINISHED" -eq 0 ]]; then
        ERROR_MSG="Backup interrupted"
        write_status "error"
        notify "⏹ $JOB_NAME" "Backup interrupted"
    fi
}

trap 'PAUSE_REQUEST=pause' USR1
trap 'PAUSE_REQUEST=resume' USR2
trap 'TERM_REQUESTED=1' TERM INT HUP
trap cleanup EXIT

# --- preflight checks ---

# preflight_fail <message>: this run cannot start. The status is written only
# when the destination is usable — never into an unmounted mount point.
preflight_fail() {
    ERROR_MSG="$1"
    echo "$JOB_NAME: $ERROR_MSG" >&2
    write_status "error"
    notify "✖ $JOB_NAME" "$ERROR_MSG"
    FINISHED=1
    exit 1
}

# Every mount point fstab lists on the way from $1 up to / must be mounted. An
# unmounted mount point is an empty directory on the parent filesystem: as a
# destination it would fill the system disk with a second copy of the source,
# as a source it would make rsync --delete empty the mirror.
# BACKUP_SYNC_FSTAB points the lookup at another fstab — for the tests only.
UNMOUNTED=""
require_mounted() {
    local dir
    dir=$(realpath -m -- "$1")
    while :; do
        if findmnt -s ${BACKUP_SYNC_FSTAB:+-F "$BACKUP_SYNC_FSTAB"} -n -M "$dir" >/dev/null 2>&1 \
                && ! mountpoint -q -- "$dir" 2>/dev/null; then
            UNMOUNTED="$dir"
            return 1
        fi
        [[ "$dir" == / ]] && return 0
        dir=$(dirname -- "$dir")
    done
}

# Anything in $1 besides the directories backup-sync keeps there itself?
has_entries() {
    [[ -n "$(find "$1" -mindepth 1 -maxdepth 1 ! -name .mirror-backup ! -name .archive \
        -print -quit 2>/dev/null)" ]]
}

require_mounted "$DST_DIR" || preflight_fail "Destination not mounted: $UNMOUNTED"
# Never created here: a missing destination is a missing mount far more often
# than a new job, and the app creates new destinations when it saves the job.
[[ -d "$DST_DIR" ]] || preflight_fail "Destination not found: $DST (not mounted?)"
mkdir -p "$STATE_DIR" 2>/dev/null || preflight_fail "Cannot write to the destination: $STATE_DIR"
STATE_OK=1

require_mounted "$SRC" || preflight_fail "Source not mounted: $UNMOUNTED"
[[ -d "$SRC" ]] || preflight_fail "Source not found: $SRC"
if [[ "${BACKUP_SYNC_DELETE_MODE:-before}" != disabled ]] && ! has_entries "$SRC" \
        && has_entries "$DST_DIR"; then
    preflight_fail "Source is empty but the mirror is not — refusing to delete the whole backup ($SRC not mounted?)"
fi

# --- a scheduled run another machine already made ---
#
# systemd sets TRIGGER_UNIT for a service its timer started. Persistent timers
# catch up on runs missed while this install was down — but the history is
# shared, and when another machine (the other OS of a dual boot, typically)
# succeeded after the last scheduled time, the catch-up would only repeat it.
# The slot counts as covered when the first scheduled time after the start of
# the last successful run still lies in the future.

# The timer's calendar expressions, one per line.
trigger_calendars() {
    if [[ -n "${BACKUP_SYNC_SCHEDULE:-}" ]]; then   # tests
        printf '%s\n' "$BACKUP_SYNC_SCHEDULE"
        return
    fi
    systemctl --user show -P TimersCalendar "$TRIGGER_UNIT" 2>/dev/null \
        | sed -n 's/.*OnCalendar=\(.*\) ; next_elapse=.*/\1/p'
}

# "<started>\t<host>" of the newest successful run in the history, if any.
last_success() {
    [[ -f "$HISTORY_FILE" ]] || return 0
    awk '/"exit_code":[[:space:]]*0[,}]/ { line = $0 } END { if (line == "") exit
        started = line; sub(/.*"started":"/, "", started); sub(/".*/, "", started)
        host = ""; if (line ~ /"host":"/) { host = line; sub(/.*"host":"/, "", host); sub(/".*/, "", host) }
        print started "\t" host }' "$HISTORY_FILE"
}

# Epoch of the first elapse of any of the calendars after epoch $1.
next_elapse_after() {
    local base="$1" when first=""
    local -a calendars=()
    mapfile -t calendars < <(trigger_calendars)
    (( ${#calendars[@]} )) || return 1
    while IFS= read -r when; do
        when=$(date -u -d "$when" +%s 2>/dev/null) || continue
        [[ -z "$first" ]] || (( when < first )) && first="$when"
    done < <(systemd-analyze calendar --iterations=1 --base-time="@$base" "${calendars[@]}" 2>/dev/null \
        | sed -n 's/^[[:space:]]*(in UTC): //p')
    [[ -n "$first" ]] && echo "$first"
}

if [[ -n "${TRIGGER_UNIT:-}" ]]; then
    IFS=$'\t' read -r LAST_STARTED LAST_HOST < <(last_success) || true
    if [[ -n "${LAST_STARTED:-}" ]] \
            && LAST_EPOCH=$(date -d "$LAST_STARTED" +%s 2>/dev/null) \
            && NEXT_DUE=$(next_elapse_after "$LAST_EPOCH") \
            && (( NEXT_DUE > $(date +%s) )); then
        MSG="skipped: the run started $LAST_STARTED${LAST_HOST:+ on $LAST_HOST} covers this slot, next due $(date -d "@$NEXT_DUE" -Iseconds)"
        echo "=== $(date -Iseconds) === $TRIGGER_UNIT $MSG ===" >> "$LOG_FILE"
        echo "$JOB_NAME: $MSG"
        FINISHED=1
        exit 0
    fi
fi

# --- job queue: wait for exclusive lock ---
# Only one backup runs at a time. Others wait in FIFO order.

# This run supersedes any postponed one; a failed preflight above keeps the
# marker so the next start tries again.
rm -f "$DEFERRED_FILE"

exec 9>"$LOCK_FILE"
if ! flock -n 9 2>/dev/null; then
    write_status "queued"
    notify "⏳ $JOB_NAME" "Waiting for another backup to finish"
    # Blocking wait in the background: a foreground command would hold off the
    # SIGTERM trap until the lock came free. The lock belongs to the open file
    # description, which the child shares with us, so it outlives the child.
    flock 9 &
    FLOCK_PID=$!
    while :; do
        FLOCK_RC=0
        wait "$FLOCK_PID" 2>/dev/null || FLOCK_RC=$?
        handle_signals
        # >128 with flock still alive: a trapped signal cut the wait short
        (( FLOCK_RC > 128 )) && kill -0 "$FLOCK_PID" 2>/dev/null && continue
        break
    done
    FLOCK_PID=""
    if (( FLOCK_RC != 0 )); then
        ERROR_MSG="Could not acquire the job queue lock (flock exit $FLOCK_RC)"
        write_status "error"
        notify "✖ $JOB_NAME" "$ERROR_MSG"
        FINISHED=1
        exit 1
    fi
fi
# Lock acquired — reset start time to now (excludes queue wait)
START_TIME="$(date -Iseconds)"
START_EPOCH="$(date +%s)"

# --- build rsync args ---

# Delete mode: before (default), during, after, or disabled
DELETE_MODE="${BACKUP_SYNC_DELETE_MODE:-before}"
DELETE_ARG=""
case "$DELETE_MODE" in
    before)  DELETE_ARG="--delete-before" ;;
    during)  DELETE_ARG="--delete-during" ;;
    after)   DELETE_ARG="--delete-after" ;;
    disabled) DELETE_ARG="" ;;
    *)       DELETE_ARG="--delete-before" ;;
esac

RSYNC_ARGS=(
    -a
    # What the progress filter counts: see "progress" above.
    --info=progress2,flist2
    --debug=del2
    --itemize-changes --itemize-changes
    --no-inc-recursive
    --human-readable
    --outbuf=L
    # The job's own state in the destination: excluded, so --delete leaves it
    # alone. Unanchored, so another job's state inside the source (a job whose
    # destination lies within this one's source) is not mirrored either.
    --exclude=.mirror-backup/
)

[[ -n "$DELETE_ARG" ]] && RSYNC_ARGS+=("$DELETE_ARG")

if [[ -n "$EXCLUDE_FILE" && -f "$EXCLUDE_FILE" ]]; then
    RSYNC_ARGS+=(--exclude-from="$EXCLUDE_FILE")
fi

if [[ "$ARCHIVE_DAYS" -gt 0 ]]; then
    ARCHIVE_DIR="$DST/.archive/$(date +%Y-%m-%d_%H%M%S)"
    # The archive lives inside the destination, so rsync sees it as extraneous.
    # Without this exclude it does not delete it — it *backs it up*, moving the
    # previous archive into the new one and nesting them one level deeper every
    # run (backup-secondary reached four levels before this was spotted, and the
    # maxdepth-1 pruning below could never reach the buried ones).
    RSYNC_ARGS+=(--backup "--backup-dir=$ARCHIVE_DIR" --exclude=/.archive/)
fi

# --- optional rsync features (env vars set by systemd service) ---

# Bandwidth limit (KB/s)
if [[ -n "${BACKUP_SYNC_BWLIMIT:-}" && "${BACKUP_SYNC_BWLIMIT:-0}" -gt 0 ]]; then
    RSYNC_ARGS+=("--bwlimit=${BACKUP_SYNC_BWLIMIT}")
fi

# Compression
[[ "${BACKUP_SYNC_COMPRESS:-0}" == "1" ]] && RSYNC_ARGS+=(--compress)

# Checksum-based comparison instead of time+size
[[ "${BACKUP_SYNC_CHECKSUM:-0}" == "1" ]] && RSYNC_ARGS+=(--checksum)

# Preserve hard links
[[ "${BACKUP_SYNC_HARD_LINKS:-0}" == "1" ]] && RSYNC_ARGS+=(--hard-links)

# Preserve extended attributes
[[ "${BACKUP_SYNC_XATTRS:-0}" == "1" ]] && RSYNC_ARGS+=(--xattrs)

# Preserve ACLs
[[ "${BACKUP_SYNC_ACLS:-0}" == "1" ]] && RSYNC_ARGS+=(--acls)

# Resume partial transfers
[[ "${BACKUP_SYNC_PARTIAL:-0}" == "1" ]] && RSYNC_ARGS+=(--partial)

# Skip newer files on destination
[[ "${BACKUP_SYNC_UPDATE:-0}" == "1" ]] && RSYNC_ARGS+=(--update)

# Max file size
if [[ -n "${BACKUP_SYNC_MAX_SIZE:-}" ]]; then
    RSYNC_ARGS+=("--max-size=${BACKUP_SYNC_MAX_SIZE}")
fi

# Min file size
if [[ -n "${BACKUP_SYNC_MIN_SIZE:-}" ]]; then
    RSYNC_ARGS+=("--min-size=${BACKUP_SYNC_MIN_SIZE}")
fi

# --- rotate log ---

if [[ -f "$LOG_FILE" ]] && (( $(stat -c%s "$LOG_FILE" 2>/dev/null || echo 0) > 16777216 )); then
    mv -f "$LOG_FILE" "$LOG_FILE.prev"
fi

# --- go ---

# Every tick while rsync runs: turn its progress into the status file.
rsync_tick() {
    [[ "$IS_PAUSED" -eq 0 ]] || return 0
    read_progress || true
    if (( ! COMPARED )) && [[ -r "/proc/$RSYNC_PID/io" ]]; then
        SCAN_READ=$(format_bytes "$(awk '/^read_bytes:/ {print $2}' "/proc/$RSYNC_PID/io" 2>/dev/null || echo 0)")
    fi
    write_active_status
}

read -r EST_FILES EST_DIRS < <(previous_totals) || true
EST_FILES=${EST_FILES:-0} EST_DIRS=${EST_DIRS:-0}

echo "$$ " > "$PID_FILE"
notify "🔄 $JOB_NAME" "$SRC → $DST"
start_sleep_guard

while :; do
    LAST_PCT=0 LAST_SPEED="" LAST_ETA="" CURRENT_FILE="" SCAN_READ=""
    FILES_XFRD=0 FILES_TOTAL=0 FILES_REMAINING=0 DIRS_SEEN=0 COMPARED=0
    PHASE="" PHASE_DONE=0 PHASE_TOTAL=0 PHASE_ESTIMATED=0 PROGRESS_EOF=0
    TRANSFER_SEQ="" TRANSFER_EPOCH=0
    write_status "scanning"
    echo "=== $START_TIME === $JOB_NAME: $SRC → $DST ===" >> "$LOG_FILE"

    rm -f "$PROGRESS_FILE"
    rsync "${RSYNC_ARGS[@]}" "$SRC" "$DST" \
        > >(stdbuf -oL tr '\r' '\n' | "${PROGRESS_FILTER[@]}") \
        2>> "$LOG_FILE" &
    RSYNC_PID=$!
    echo "$$ $RSYNC_PID" > "$PID_FILE"
    acquire_inhibitor
    if (( WAS_PAUSED )); then
        pause_rsync   # the user's pause outlives the suspend
        WAS_PAUSED=0
    fi

    supervise "$RSYNC_PID" rsync_tick && break

    stop_rsync_for_suspend
    # Start over rather than resume: rsync needs a fresh file list anyway, and
    # the pass after wake is what the history entry and the log should show.
    START_TIME="$(date -Iseconds)"
    START_EPOCH="$(date +%s)"
    notify "🔄 $JOB_NAME" "Restarting after wake"
done

# The filter writes its last snapshot once rsync's output has ended.
for _ in {1..50}; do
    if read_progress && (( PROGRESS_EOF )); then break; fi
    sleep 0.1
done

# Capture rsync exit code without tripping `set -e` on non-zero (e.g. 23 = partial)
RSYNC_EXIT=0
wait "$RSYNC_PID" 2>/dev/null || RSYNC_EXIT=$?

# --- archive cleanup ---

prune_archive() {
    # gio trash cannot be used here: this runs unattended, the destination may be
    # a NAS mount, and an expired archive is by definition already a second copy.
    find "$DST/.archive" -mindepth 1 -maxdepth 1 -type d -mtime "+$ARCHIVE_DAYS" \
        -exec rm -rf {} + 2>/dev/null || true
    rmdir "$DST/.archive" 2>/dev/null || true
}

if [[ "$ARCHIVE_DAYS" -gt 0 && -d "$DST/.archive" ]]; then
    PHASE=pruning PHASE_DONE=0 PHASE_TOTAL=0 PHASE_ESTIMATED=0
    LAST_PCT=0 LAST_SPEED="" LAST_ETA="" CURRENT_FILE=""
    write_status "running"
    # The destination can be a FUSE mount too, so pruning runs under the same
    # suspend guard; stopped halfway, it simply runs again after wake.
    while :; do
        prune_archive &
        PRUNE_PID=$!
        supervise "$PRUNE_PID" no_tick && break
        stop_tree "$PRUNE_PID"
        wait_for_wake
        acquire_inhibitor
    done
    PRUNE_PID=""
fi
stop_sleep_guard

# --- finish: classify outcome ---

FINISHED=1
FINAL_STATE="idle"
PHASE="" PHASE_DONE=0 PHASE_TOTAL=0 PHASE_ESTIMATED=0 LAST_SPEED="" LAST_ETA=""
if [[ "$RSYNC_EXIT" -eq 0 || "$RSYNC_EXIT" -eq 23 || "$RSYNC_EXIT" -eq 24 ]]; then
    LAST_PCT=100
    CURRENT_FILE=""
    if [[ "$RSYNC_EXIT" -ne 0 ]]; then
        ERROR_MSG="Partial transfer (exit $RSYNC_EXIT) — some files skipped"
    else
        ERROR_MSG=""
    fi
    HISTORY_EXIT=0  # tolerate 23/24 as success in history
    RSYNC_EXIT=0
else
    ERROR_MSG=$(tail -5 "$LOG_FILE" 2>/dev/null | grep -v '^===' | head -3 | tr '\n' ' ' | sed 's/  */ /g; s/^ *//; s/ *$//') || true
    FINAL_STATE="error"
    HISTORY_EXIT="$RSYNC_EXIT"
    DIRS_SEEN=0   # a comparison cut short counted only part of them
fi

# --- write history entry (must happen before streak compute) ---

FINISH_TIME="$(date -Iseconds)"
FINISH_EPOCH="$(date +%s)"
DURATION_SEC=$(( FINISH_EPOCH - START_EPOCH ))
printf '{"started":"%s","finished":"%s","duration_sec":%d,"exit_code":%d,"files_transferred":%d,"files_total":%d,"dirs_total":%d,"error":"%s","host":"%s"}\n' \
    "$START_TIME" "$FINISH_TIME" "$DURATION_SEC" "$HISTORY_EXIT" \
    "${FILES_XFRD:-0}" "${FILES_TOTAL:-0}" "${DIRS_SEEN:-0}" \
    "$(json_escape "${ERROR_MSG:-}")" "$(json_escape "$HOST")" \
    >> "$HISTORY_FILE"

# --- compute consecutive failure streak + detect suggested excludes ---

CONSECUTIVE_FAILURES=$(compute_failure_streak "$HISTORY_FILE")
SUGGESTED_EXCLUDES_JSON=$(suggest_excludes_from_log | to_json_array)

# --- write final status (with streak + suggestions) and notify ---

write_status "$FINAL_STATE"

if [[ "$FINAL_STATE" == "idle" ]]; then
    if [[ -n "$ERROR_MSG" ]]; then
        notify "✔ $JOB_NAME" "Backup completed with warnings"
    else
        notify "✔ $JOB_NAME" "Backup completed"
    fi
elif (( CONSECUTIVE_FAILURES >= FAILURE_STREAK_THRESHOLD )); then
    # Persistent failure — escalate to critical urgency, sticky until dismissed
    notify "✖ $JOB_NAME failed ${CONSECUTIVE_FAILURES}× in a row" \
        "${ERROR_MSG:-Backup failed (exit $HISTORY_EXIT)}" 2 0
else
    notify "✖ $JOB_NAME" "Backup failed (exit $HISTORY_EXIT)"
fi

rm -f "$PROGRESS_FILE"
echo "=== $(date -Iseconds) === finished (exit $RSYNC_EXIT) ===" >> "$LOG_FILE"

# --- rotate history (keeps file from growing unbounded) ---

rotate_history "$HISTORY_FILE" "$HISTORY_KEEP"

exit "$RSYNC_EXIT"
