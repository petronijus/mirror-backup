#!/usr/bin/env bash
# backup-sync — rsync wrapper with progress tracking and desktop notifications
# Usage: backup-sync <job-name> <src> <dst> [exclude-file] [archive-days]
#        backup-sync --resume-deferred
#
# A run cut short by suspend, shutdown or logout is postponed, not failed:
# suspend stops rsync and runs it again after wake, shutdown/logout leave a
# <job>.deferred marker that `--resume-deferred` (mirror-backup-resume.service,
# once per user-manager start) turns back into a run.

set -euo pipefail

STATUS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/backup-sync/status"
LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/backup-sync/logs"
HISTORY_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/backup-sync/history"
mkdir -p "$STATUS_DIR" "$LOG_DIR" "$HISTORY_DIR"

# Start every job whose last run did not get to finish: postponed ones (a
# .deferred marker) and ones killed without warning — power loss, hard reset,
# a hung kernel — whose status file still says active but predates this boot.
resume_deferred() {
    local boot_epoch marker status_file job state updated updated_epoch
    local -A pending=()
    boot_epoch=$(awk '/^btime / {print $2}' /proc/stat)
    shopt -s nullglob

    for marker in "$STATUS_DIR"/*.deferred; do
        pending["$(basename "$marker" .deferred)"]="postponed"
    done

    for status_file in "$STATUS_DIR"/*.json; do
        job=$(basename "$status_file" .json)
        state=$(grep -oP '"state":\s*"\K[^"]+' "$status_file" 2>/dev/null) || continue
        case "$state" in
            running|scanning|paused|queued) ;;
            *) continue ;;
        esac
        updated=$(grep -oP '"updated":\s*"\K[^"]+' "$status_file" 2>/dev/null) || continue
        updated_epoch=$(date -d "$updated" +%s 2>/dev/null) || continue
        if (( updated_epoch < boot_epoch )); then
            pending["$job"]="interrupted"
        fi
    done

    for job in "${!pending[@]}"; do
        if [[ "$(systemctl --user show -P LoadState "$job.service" 2>/dev/null)" != loaded ]]; then
            echo "$job: unit no longer exists, dropping its ${pending[$job]} run"
            rm -f "$STATUS_DIR/$job.deferred"
            continue
        fi
        echo "$job: restarting ${pending[$job]} run"
        systemctl --user start --no-block "$job.service"
    done
}

if [[ "${1:-}" == "--resume-deferred" ]]; then
    resume_deferred
    exit 0
fi

JOB_NAME="${1:?Usage: backup-sync <job-name> <src> <dst> [exclude-file] [archive-days]}"
SRC="${2:?Missing source path}"
DST="${3:?Missing destination path}"
EXCLUDE_FILE="${4:-}"
ARCHIVE_DAYS="${5:-0}"

STATUS_FILE="$STATUS_DIR/$JOB_NAME.json"
PID_FILE="$STATUS_DIR/$JOB_NAME.pid"
LOG_FILE="$LOG_DIR/$JOB_NAME.log"
PROGRESS_FILE="$STATUS_DIR/$JOB_NAME.progress"
LOCK_FILE="$STATUS_DIR/backup-sync.lock"
DEFERRED_FILE="$STATUS_DIR/$JOB_NAME.deferred"

# logind endpoint the suspend guard listens to. Overridable only so the
# suspend path can be exercised against a fake logind on the session bus.
LOGIND_BUS="${BACKUP_SYNC_LOGIND_BUS:-system}"
LOGIND_NAME="${BACKUP_SYNC_LOGIND_NAME:-org.freedesktop.login1}"
RSYNC_STOP_GRACE="${BACKUP_SYNC_STOP_GRACE:-10}"   # seconds between SIGTERM and SIGKILL

RSYNC_PID=""
PRUNE_PID=""
FLOCK_PID=""
INHIBIT_PID=""
SLEEP_GUARD=0      # 1 while the logind signal monitor (coprocess SLEEP_MON) runs
SLEEP_EVENT=""     # "start" / "end" after wait_tick saw PrepareForSleep
DEFERRED=0
DEFER_REASON=""    # "suspend" or "shutdown"
WAS_PAUSED=0       # rsync was paused when a suspend stopped it
LAST_PCT=0
LAST_SPEED=""
LAST_ETA=""
CURRENT_FILE=""
FILES_XFRD=0
FILES_TOTAL=0
FILES_REMAINING=0
ERROR_MSG=""
SCAN_READ=""
FINISHED=0
IS_PAUSED=0
SEEN_PROGRESS=0
CONSECUTIVE_FAILURES=0
SUGGESTED_EXCLUDES_JSON="[]"
START_TIME="$(date -Iseconds)"
START_EPOCH="$(date +%s)"

HISTORY_KEEP="${BACKUP_SYNC_HISTORY_KEEP:-200}"
FAILURE_STREAK_THRESHOLD="${BACKUP_SYNC_STREAK_THRESHOLD:-3}"

# --- helpers ---

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

format_bytes() {
    local bytes=$1
    if (( bytes >= 1073741824 )); then
        local whole=$((bytes / 1073741824))
        local frac=$(( (bytes % 1073741824) * 10 / 1073741824 ))
        printf '%d.%d GB' "$whole" "$frac"
    elif (( bytes >= 1048576 )); then
        local whole=$((bytes / 1048576))
        local frac=$(( (bytes % 1048576) * 10 / 1048576 ))
        printf '%d.%d MB' "$whole" "$frac"
    elif (( bytes >= 1024 )); then
        printf '%d KB' $((bytes / 1024))
    else
        printf '%d B' "$bytes"
    fi
}

write_status() {
    local state="$1"
    local escaped_file escaped_error
    escaped_file=$(json_escape "${CURRENT_FILE:-}")
    escaped_error=$(json_escape "${ERROR_MSG:-}")
    cat > "${STATUS_FILE}.tmp" <<-JEOF
{
  "job": "$JOB_NAME",
  "state": "$state",
  "progress": ${LAST_PCT:-0},
  "speed": "${LAST_SPEED:-}",
  "eta": "${LAST_ETA:-}",
  "current_file": "$escaped_file",
  "files_transferred": ${FILES_XFRD:-0},
  "files_total": ${FILES_TOTAL:-0},
  "files_remaining": ${FILES_REMAINING:-0},
  "pid": $$,
  "rsync_pid": ${RSYNC_PID:-0},
  "started": "$START_TIME",
  "updated": "$(date -Iseconds)",
  "scan_read": "${SCAN_READ:-}",
  "src": "$SRC",
  "dst": "$DST",
  "error": "$escaped_error",
  "deferred_reason": "${DEFER_REASON:-}",
  "consecutive_failures": ${CONSECUTIVE_FAILURES:-0},
  "suggested_excludes": ${SUGGESTED_EXCLUDES_JSON:-[]}
}
JEOF
    mv -f "${STATUS_FILE}.tmp" "$STATUS_FILE"
}

# notify <summary> <body> [urgency] [expire_ms]
# urgency: 0=low, 1=normal (default), 2=critical
# expire_ms: 0 = never auto-dismiss (sticky), default 5000
notify() {
    local urgency="${3:-1}"
    local expire="${4:-5000}"
    gdbus call --session \
        --dest=org.freedesktop.Notifications \
        --object-path=/org/freedesktop/Notifications \
        --method=org.freedesktop.Notifications.Notify \
        "Backup Sync" 0 "drive-harddisk" "$1" "$2" '[]' \
        "{'urgency': <byte $urgency>}" "$expire" \
        >/dev/null 2>&1 || true
}

# Count trailing failures in the history JSONL (newest entries first walk-back).
# Stops at the first successful entry. Echoes the streak count.
compute_failure_streak() {
    local file="$1"
    [[ -f "$file" ]] || { echo 0; return; }
    awk '
        { lines[NR] = $0 }
        END {
            streak = 0
            for (i = NR; i >= 1; i--) {
                if (lines[i] ~ /"exit_code":[[:space:]]*0,/) break
                if (lines[i] ~ /"exit_code":[[:space:]]*[0-9]+,/) streak++
            }
            print streak
        }
    ' "$file"
}

# Trim history file to last N entries (atomic via temp + rename).
rotate_history() {
    local file="$1" keep="$2"
    [[ -f "$file" ]] || return 0
    local lines
    lines=$(wc -l < "$file" 2>/dev/null) || return 0
    if (( lines > keep )); then
        tail -n "$keep" "$file" > "${file}.tmp" && mv -f "${file}.tmp" "$file"
    fi
}

# Scan the CURRENT run's log section for "Permission denied" rsync errors and
# emit deduped top-level paths (relative to SRC) that the user can add to the
# exclude file. Looks only at lines after the `=== <START_TIME> ===` marker so
# a previously-resolved error doesn't keep showing up.
# Output: one path per line on stdout (empty if no errors).
# Implemented as a single awk so empty matches don't trip pipefail+set -e.
suggest_excludes_from_log() {
    [[ -f "$LOG_FILE" ]] || return 0
    local src_clean="${SRC%/}"
    local marker="=== ${START_TIME} ==="
    awk -v marker="$marker" -v src="$src_clean" '
        BEGIN { srclen = length(src) + 1 }
        !found {
            if (index($0, marker) == 1) found = 1
            next
        }
        /Permission denied/ {
            if (match($0, /"[^"]+"/)) {
                path = substr($0, RSTART + 1, RLENGTH - 2)
                if (substr(path, 1, srclen) == src "/") {
                    rel = substr(path, srclen + 1)
                    slash = index(rel, "/")
                    top = (slash > 0) ? substr(rel, 1, slash - 1) : rel
                    if (top != "") seen[top] = 1
                }
            }
        }
        END { for (s in seen) print s }
    ' "$LOG_FILE" | sort
}

# Build a JSON array literal from newline-delimited stdin, e.g. "a\nb\n" → ["a","b"]
to_json_array() {
    local first=1 out="["
    while IFS= read -r item; do
        [[ -z "$item" ]] && continue
        local escaped
        escaped=$(json_escape "$item")
        if (( first )); then
            out+="\"$escaped\""
            first=0
        else
            out+=",\"$escaped\""
        fi
    done
    out+="]"
    printf '%s' "$out"
}

parse_progress() {
    [[ -f "$PROGRESS_FILE" ]] || return 1

    local recent last_progress last_file
    recent=$(tail -50 "$PROGRESS_FILE" 2>/dev/null) || return 1
    [[ -z "$recent" ]] && return 1

    last_progress=$(echo "$recent" | grep -E '[0-9]+%.*B/s' | tail -1) || true
    last_file=$(echo "$recent" | grep -vE '^[[:space:]]*$|[0-9]+%|^sending |^receiving |^total |^sent |^created |^building ' | tail -1) || true

    if [[ -n "$last_progress" ]]; then
        if [[ "$last_progress" =~ ([0-9]+)%[[:space:]]+([^[:space:]]+/s)[[:space:]]+([0-9:]+) ]]; then
            LAST_PCT="${BASH_REMATCH[1]}"
            LAST_SPEED="${BASH_REMATCH[2]}"
            LAST_ETA="${BASH_REMATCH[3]}"
        fi

        if [[ "$last_progress" =~ xfr#([0-9]+),[[:space:]]*(to-chk|ir-chk)=([0-9]+)/([0-9]+) ]]; then
            FILES_XFRD="${BASH_REMATCH[1]}"
            FILES_REMAINING="${BASH_REMATCH[3]}"
            FILES_TOTAL="${BASH_REMATCH[4]}"
        fi

        [[ -n "$last_file" ]] && CURRENT_FILE="$last_file"
        return 0
    fi

    if [[ -n "$last_file" ]]; then
        CURRENT_FILE="$last_file"
        return 0
    fi

    return 1
}

truncate_progress_file() {
    local fsize
    fsize=$(stat -c%s "$PROGRESS_FILE" 2>/dev/null) || return 0
    if (( fsize > 1048576 )); then
        tail -100 "$PROGRESS_FILE" > "${PROGRESS_FILE}.tmp" 2>/dev/null
        mv -f "${PROGRESS_FILE}.tmp" "$PROGRESS_FILE" 2>/dev/null || true
    fi
}

# --- stopping rsync / postponing the run ---

descendants() {
    local child
    for child in $(pgrep -P "$1" 2>/dev/null); do
        echo "$child"
        descendants "$child"
    done
}

# "pid:starttime" for $1 and every process below it. The start time pins the
# identity, so a PID the kernel hands out again is never mistaken for ours.
proc_tree() {
    local pid stat fields
    for pid in "$1" $(descendants "$1"); do
        { stat=$(< "/proc/$pid/stat"); } 2>/dev/null || continue
        read -ra fields <<< "${stat##*) }"   # fields after "(comm) "
        echo "$pid:${fields[19]}"
    done
}

# Any process of a proc_tree snapshot still alive?
tree_alive() {
    local entry pid stat fields
    for entry in "$@"; do
        pid="${entry%%:*}"
        { stat=$(< "/proc/$pid/stat"); } 2>/dev/null || continue
        read -ra fields <<< "${stat##*) }"
        [[ "${fields[19]}" == "${entry#*:}" && "${fields[0]}" != Z ]] && return 0
    done
    return 1
}

# Stop background child $1 and everything it forked (a local rsync transfer
# is a sender, receiver and generator trio), and wait until all of them are
# gone — for a suspend, any survivor could still be inside a FUSE request.
# SIGTERM first so rsync removes its temp files; SIGCONT because a paused
# (SIGSTOPped) rsync cannot act on anything; SIGKILL for whatever is still
# there after the grace period.
stop_tree() {
    local root="$1" entry waited=0
    local -a tree=() pids=()
    [[ -n "$root" ]] && kill -0 "$root" 2>/dev/null || return 0
    mapfile -t tree < <(proc_tree "$root")
    for entry in "${tree[@]}"; do pids+=("${entry%%:*}"); done
    kill -TERM "${pids[@]}" 2>/dev/null || true
    kill -CONT "${pids[@]}" 2>/dev/null || true
    while tree_alive "${tree[@]}" && (( waited < RSYNC_STOP_GRACE * 10 )); do
        sleep 0.1
        waited=$((waited + 1))
    done
    for entry in "${tree[@]}"; do
        tree_alive "$entry" && kill -KILL "${entry%%:*}" 2>/dev/null
    done
    wait "$root" 2>/dev/null || true
}

stop_rsync() {
    stop_tree "$RSYNC_PID"
    IS_PAUSED=0
}

# True while the user's service manager or the whole system is going down —
# shutdown, reboot, or logout of a user without lingering. A SIGTERM arriving
# then is not somebody pressing Stop, so the run is postponed instead of failed.
session_stopping() {
    local scope state
    for scope in --user --system; do
        state=$(timeout 5 systemctl "$scope" is-system-running 2>/dev/null) || true
        [[ "$state" == stopping ]] && return 0
    done
    return 1
}

defer() {
    DEFERRED=1
    DEFER_REASON="$1"
    printf '{"reason": "%s", "since": "%s"}\n' "$1" "$(date -Iseconds)" > "$DEFERRED_FILE"
}

# --- suspend guard ---
#
# rsync blocked inside a FUSE request (NTFS via ntfs-3g, rclone, sshfs …)
# cannot be frozen for suspend: the freezer stops the FUSE daemon as well, the
# request never completes, and after 20 s the kernel aborts the suspend. So
# while rsync runs we hold a logind *delay* inhibitor. logind announces the
# suspend with PrepareForSleep(true) and waits for us; the FUSE daemon is still
# running at that point, the pending request completes, rsync exits, and only
# then is the inhibitor released. After PrepareForSleep(false) the run starts
# over. Needs gdbus and systemd-inhibit; without them the guard stays off.

start_sleep_guard() {
    command -v gdbus >/dev/null && command -v systemd-inhibit >/dev/null \
        && command -v stdbuf >/dev/null || return 0
    coproc SLEEP_MON {
        exec stdbuf -oL gdbus monitor "--$LOGIND_BUS" --dest "$LOGIND_NAME" \
            --object-path /org/freedesktop/login1 2>/dev/null 9>&-
    }
    # gdbus prints the owner line once its match rule is in place; taking the
    # inhibitor any earlier could hold up a suspend whose signal we then miss.
    local line
    while [[ -n "${SLEEP_MON[0]:-}" ]] && IFS= read -r -t 5 -u "${SLEEP_MON[0]}" line; do
        if [[ "$line" == "The name $LOGIND_NAME is owned by "* ]]; then
            SLEEP_GUARD=1
            return 0
        fi
    done
    stop_sleep_guard
}

stop_sleep_guard() {
    release_inhibitor
    if [[ -n "${SLEEP_MON_PID:-}" ]]; then
        kill "$SLEEP_MON_PID" 2>/dev/null || true
        wait "$SLEEP_MON_PID" 2>/dev/null || true
    fi
    SLEEP_GUARD=0
}

acquire_inhibitor() {
    (( SLEEP_GUARD )) && [[ -z "$INHIBIT_PID" ]] || return 0
    systemd-inhibit --what=sleep --mode=delay --who="Mirror Backup" \
        --why="Stopping $JOB_NAME before suspend" sleep infinity 9>&- &
    INHIBIT_PID=$!
}

release_inhibitor() {
    [[ -n "$INHIBIT_PID" ]] || return 0
    kill "$INHIBIT_PID" 2>/dev/null || true
    wait "$INHIBIT_PID" 2>/dev/null || true
    INHIBIT_PID=""
}

# Wait up to $1 seconds (default 2) — the status-refresh tick — and report a
# logind sleep transition in SLEEP_EVENT. A trapped signal does not cut
# `read -t` short, so the tick also bounds how long a stop request waits.
wait_tick() {
    local timeout="${1:-2}" line rc=0
    SLEEP_EVENT=""
    # bash drops the SLEEP_MON array once the coprocess has exited.
    if (( SLEEP_GUARD )) && [[ -z "${SLEEP_MON[0]:-}" ]]; then
        stop_sleep_guard
    fi
    if (( SLEEP_GUARD )); then
        IFS= read -r -t "$timeout" -u "${SLEEP_MON[0]}" line || rc=$?
        if (( rc == 0 )); then
            case "$line" in
                *".PrepareForSleep (true,)"*)  SLEEP_EVENT="start" ;;
                *".PrepareForSleep (false,)"*) SLEEP_EVENT="end" ;;
            esac
            return 0
        fi
        (( rc > 128 )) && return 0    # timed out, or a trapped signal
        stop_sleep_guard              # EOF: the monitor died, fall back to polling
    fi
    sleep "$timeout" &
    wait $! 2>/dev/null || true
}

# Networked source or destination (NFS, SMB, sshfs, rclone …)? Decided from
# the mount table alone, so a server that is still unreachable cannot hang it.
on_network_fs() {
    local path fstype
    for path in "$SRC" "$DST"; do
        fstype=$(findmnt -n -o FSTYPE --target "$path" 2>/dev/null) || continue
        case "$fstype" in
            nfs|nfs4|cifs|smb3|ceph|glusterfs|9p|fuse.sshfs|fuse.rclone|fuse.s3fs|fuse.gcsfuse)
                return 0 ;;
        esac
    done
    return 1
}

# Let the announced suspend proceed and return once the system is back.
wait_for_wake() {
    release_inhibitor
    until [[ "$SLEEP_EVENT" == "end" ]] || (( ! SLEEP_GUARD )); do
        wait_tick   # short ticks keep a Stop during the wait responsive
        handle_signals
    done
    # Right after wake the network is typically still reconnecting.
    if on_network_fs && command -v nm-online >/dev/null; then
        nm-online -q -t 60 || true
    fi
}

# Watch background child $1 until it exits, running $2 every tick. Returns 1
# as soon as a suspend is announced (the caller then stops the child), 0 once
# the child has finished on its own.
supervise() {
    local pid="$1" on_tick="$2"
    while kill -0 "$pid" 2>/dev/null; do
        "$on_tick"
        wait_tick
        handle_signals
        [[ "$SLEEP_EVENT" == "start" ]] && return 1
    done
    return 0
}

no_tick() { :; }

# rsync was cut short by an announced suspend. Even a paused one is stopped:
# rsync's pieces are not guaranteed to be parked outside a FUSE request.
stop_rsync_for_suspend() {
    WAS_PAUSED=$IS_PAUSED
    stop_rsync
    rm -f "$PROGRESS_FILE"
    defer suspend   # the marker survives a machine that never wakes (hibernate, power off)
    write_status "deferred"
    echo "=== $(date -Iseconds) === stopped for suspend, restarts after wake ===" >> "$LOG_FILE"
    notify "⏸ $JOB_NAME" "Stopped for suspend — restarts after wake"
    wait_for_wake
    rm -f "$DEFERRED_FILE"
    DEFERRED=0
    DEFER_REASON=""
}

# --- signal handlers ---
#
# Traps only record what arrived; the work happens at the checkpoints in the
# main flow (handle_signals). A trap runs *inside* whatever builtin it
# interrupted, and when that is `read -t` — the suspend guard's tick — a
# handler that outlives the read's timeout makes bash longjmp into a dead
# stack frame and abort.

TERM_REQUESTED=0
PAUSE_REQUEST=""   # "pause" / "resume", the latest one wins

# The whole rsync tree: stopping only the sender would leave the receiver and
# generator running, and possibly sitting in a FUSE request.
pause_rsync() {
    [[ -n "$RSYNC_PID" ]] && kill -0 "$RSYNC_PID" 2>/dev/null || return 0
    # shellcheck disable=SC2046
    kill -STOP "$RSYNC_PID" $(descendants "$RSYNC_PID") 2>/dev/null || true
    IS_PAUSED=1
    write_status "paused"
}

resume_rsync() {
    [[ -n "$RSYNC_PID" ]] && kill -0 "$RSYNC_PID" 2>/dev/null || return 0
    # shellcheck disable=SC2046
    kill -CONT "$RSYNC_PID" $(descendants "$RSYNC_PID") 2>/dev/null || true
    IS_PAUSED=0
    write_status "running"
}

handle_signals() {
    if (( TERM_REQUESTED )); then
        on_terminate
    fi
    case "$PAUSE_REQUEST" in
        pause)
            if (( ! IS_PAUSED )) && [[ -n "$RSYNC_PID" ]] && kill -0 "$RSYNC_PID" 2>/dev/null; then
                pause_rsync
                notify "⏸ $JOB_NAME" "Backup paused"
            fi
            ;;
        resume)
            if (( IS_PAUSED )) && [[ -n "$RSYNC_PID" ]] && kill -0 "$RSYNC_PID" 2>/dev/null; then
                resume_rsync
                notify "▶ $JOB_NAME" "Backup resumed"
            fi
            ;;
    esac
    PAUSE_REQUEST=""
}

# SIGTERM / SIGINT / SIGHUP, acted on from handle_signals.
on_terminate() {
    trap '' TERM INT HUP
    if [[ -n "$FLOCK_PID" ]]; then
        kill "$FLOCK_PID" 2>/dev/null || true
    fi
    stop_rsync
    stop_tree "$PRUNE_PID"
    if session_stopping; then
        defer shutdown
    else
        # A deliberate stop cancels the run, including one waiting out a suspend.
        rm -f "$DEFERRED_FILE"
        DEFERRED=0
        DEFER_REASON=""
    fi
    exit 143
}

cleanup() {
    stop_rsync
    stop_tree "$PRUNE_PID"
    stop_sleep_guard
    rm -f "$PID_FILE" "$PROGRESS_FILE" "${PROGRESS_FILE}.tmp" "${STATUS_FILE}.tmp"
    if (( DEFERRED )); then
        write_status "deferred"
        echo "=== $(date -Iseconds) === postponed by $DEFER_REASON, restarts at next start ===" >> "$LOG_FILE"
        # No notification: the desktop session is going away with us.
    elif [[ "$FINISHED" -eq 0 ]]; then
        ERROR_MSG="Backup interrupted"
        write_status "error"
        notify "⏹ $JOB_NAME" "Backup interrupted"
    fi
}

trap 'PAUSE_REQUEST=pause' USR1
trap 'PAUSE_REQUEST=resume' USR2
trap 'TERM_REQUESTED=1' TERM INT HUP
trap cleanup EXIT

# --- preflight checks ---

if [[ ! -d "$SRC" ]]; then
    ERROR_MSG="Source not found: $SRC"
    write_status "error"
    notify "✖ $JOB_NAME" "$ERROR_MSG"
    FINISHED=1
    exit 1
fi

if [[ ! -d "$DST" ]]; then
    mkdir -p "$DST"
fi

# --- job queue: wait for exclusive lock ---
# Only one backup runs at a time. Others wait in FIFO order.

# This run supersedes any postponed one; a failed preflight above keeps the
# marker so the next start tries again.
rm -f "$DEFERRED_FILE"

exec 9>"$LOCK_FILE"
if ! flock -n 9 2>/dev/null; then
    write_status "queued"
    notify "⏳ $JOB_NAME" "Waiting for another backup to finish"
    # Blocking wait in the background: a foreground command would hold off the
    # SIGTERM trap until the lock came free. The lock belongs to the open file
    # description, which the child shares with us, so it outlives the child.
    flock 9 &
    FLOCK_PID=$!
    while :; do
        FLOCK_RC=0
        wait "$FLOCK_PID" 2>/dev/null || FLOCK_RC=$?
        handle_signals
        # >128 with flock still alive: a trapped signal cut the wait short
        (( FLOCK_RC > 128 )) && kill -0 "$FLOCK_PID" 2>/dev/null && continue
        break
    done
    FLOCK_PID=""
    if (( FLOCK_RC != 0 )); then
        ERROR_MSG="Could not acquire the job queue lock (flock exit $FLOCK_RC)"
        write_status "error"
        notify "✖ $JOB_NAME" "$ERROR_MSG"
        FINISHED=1
        exit 1
    fi
fi
# Lock acquired — reset start time to now (excludes queue wait)
START_TIME="$(date -Iseconds)"
START_EPOCH="$(date +%s)"

# --- build rsync args ---

# Delete mode: before (default), during, after, or disabled
DELETE_MODE="${BACKUP_SYNC_DELETE_MODE:-before}"
DELETE_ARG=""
case "$DELETE_MODE" in
    before)  DELETE_ARG="--delete-before" ;;
    during)  DELETE_ARG="--delete-during" ;;
    after)   DELETE_ARG="--delete-after" ;;
    disabled) DELETE_ARG="" ;;
    *)       DELETE_ARG="--delete-before" ;;
esac

RSYNC_ARGS=(
    -a
    --info=progress2,name1
    --no-inc-recursive
    --human-readable
    --outbuf=L
)

[[ -n "$DELETE_ARG" ]] && RSYNC_ARGS+=("$DELETE_ARG")

if [[ -n "$EXCLUDE_FILE" && -f "$EXCLUDE_FILE" ]]; then
    RSYNC_ARGS+=(--exclude-from="$EXCLUDE_FILE")
fi

if [[ "$ARCHIVE_DAYS" -gt 0 ]]; then
    ARCHIVE_DIR="$DST/.archive/$(date +%Y-%m-%d_%H%M%S)"
    # The archive lives inside the destination, so rsync sees it as extraneous.
    # Without this exclude it does not delete it — it *backs it up*, moving the
    # previous archive into the new one and nesting them one level deeper every
    # run (backup-secondary reached four levels before this was spotted, and the
    # maxdepth-1 pruning below could never reach the buried ones).
    RSYNC_ARGS+=(--backup "--backup-dir=$ARCHIVE_DIR" --exclude=/.archive/)
fi

# --- optional rsync features (env vars set by systemd service) ---

# Bandwidth limit (KB/s)
if [[ -n "${BACKUP_SYNC_BWLIMIT:-}" && "${BACKUP_SYNC_BWLIMIT:-0}" -gt 0 ]]; then
    RSYNC_ARGS+=("--bwlimit=${BACKUP_SYNC_BWLIMIT}")
fi

# Compression
[[ "${BACKUP_SYNC_COMPRESS:-0}" == "1" ]] && RSYNC_ARGS+=(--compress)

# Checksum-based comparison instead of time+size
[[ "${BACKUP_SYNC_CHECKSUM:-0}" == "1" ]] && RSYNC_ARGS+=(--checksum)

# Preserve hard links
[[ "${BACKUP_SYNC_HARD_LINKS:-0}" == "1" ]] && RSYNC_ARGS+=(--hard-links)

# Preserve extended attributes
[[ "${BACKUP_SYNC_XATTRS:-0}" == "1" ]] && RSYNC_ARGS+=(--xattrs)

# Preserve ACLs
[[ "${BACKUP_SYNC_ACLS:-0}" == "1" ]] && RSYNC_ARGS+=(--acls)

# Resume partial transfers
[[ "${BACKUP_SYNC_PARTIAL:-0}" == "1" ]] && RSYNC_ARGS+=(--partial)

# Skip newer files on destination
[[ "${BACKUP_SYNC_UPDATE:-0}" == "1" ]] && RSYNC_ARGS+=(--update)

# Max file size
if [[ -n "${BACKUP_SYNC_MAX_SIZE:-}" ]]; then
    RSYNC_ARGS+=("--max-size=${BACKUP_SYNC_MAX_SIZE}")
fi

# Min file size
if [[ -n "${BACKUP_SYNC_MIN_SIZE:-}" ]]; then
    RSYNC_ARGS+=("--min-size=${BACKUP_SYNC_MIN_SIZE}")
fi

# --- rotate log ---

if [[ -f "$LOG_FILE" ]] && (( $(stat -c%s "$LOG_FILE" 2>/dev/null || echo 0) > 16777216 )); then
    mv -f "$LOG_FILE" "$LOG_FILE.prev"
fi

# --- go ---

# Every tick while rsync runs: turn its progress output into the status file.
rsync_tick() {
    [[ "$IS_PAUSED" -eq 0 ]] || return 0
    if parse_progress; then
        SEEN_PROGRESS=1
        write_status "running"
    elif [[ "$SEEN_PROGRESS" -eq 0 ]]; then
        if [[ -r "/proc/$RSYNC_PID/io" ]]; then
            SCAN_READ=$(format_bytes "$(awk '/^read_bytes:/ {print $2}' "/proc/$RSYNC_PID/io" 2>/dev/null || echo 0)")
        fi
        write_status "scanning"
    fi
    truncate_progress_file
}

echo "$$ " > "$PID_FILE"
notify "🔄 $JOB_NAME" "$SRC → $DST"
start_sleep_guard

while :; do
    LAST_PCT=0 LAST_SPEED="" LAST_ETA="" CURRENT_FILE="" SCAN_READ=""
    FILES_XFRD=0 FILES_TOTAL=0 FILES_REMAINING=0 SEEN_PROGRESS=0
    write_status "scanning"
    echo "=== $START_TIME === $JOB_NAME: $SRC → $DST ===" >> "$LOG_FILE"

    rm -f "$PROGRESS_FILE"
    rsync "${RSYNC_ARGS[@]}" "$SRC" "$DST" \
        > >(stdbuf -oL tr '\r' '\n' > "$PROGRESS_FILE") \
        2>> "$LOG_FILE" &
    RSYNC_PID=$!
    echo "$$ $RSYNC_PID" > "$PID_FILE"
    acquire_inhibitor
    if (( WAS_PAUSED )); then
        pause_rsync   # the user's pause outlives the suspend
        WAS_PAUSED=0
    fi

    supervise "$RSYNC_PID" rsync_tick && break

    stop_rsync_for_suspend
    # Start over rather than resume: rsync needs a fresh file list anyway, and
    # the pass after wake is what the history entry and the log should show.
    START_TIME="$(date -Iseconds)"
    START_EPOCH="$(date +%s)"
    notify "🔄 $JOB_NAME" "Restarting after wake"
done

# Read any remaining output after rsync exits
sleep 0.5
parse_progress || true

# Capture rsync exit code without tripping `set -e` on non-zero (e.g. 23 = partial)
RSYNC_EXIT=0
wait "$RSYNC_PID" 2>/dev/null || RSYNC_EXIT=$?

# --- archive cleanup ---

prune_archive() {
    # gio trash cannot be used here: this runs unattended, the destination may be
    # a NAS mount, and an expired archive is by definition already a second copy.
    find "$DST/.archive" -mindepth 1 -maxdepth 1 -type d -mtime "+$ARCHIVE_DAYS" \
        -exec rm -rf {} + 2>/dev/null || true
    rmdir "$DST/.archive" 2>/dev/null || true
}

if [[ "$ARCHIVE_DAYS" -gt 0 && -d "$DST/.archive" ]]; then
    # The destination can be a FUSE mount too, so pruning runs under the same
    # suspend guard; stopped halfway, it simply runs again after wake.
    while :; do
        prune_archive &
        PRUNE_PID=$!
        supervise "$PRUNE_PID" no_tick && break
        stop_tree "$PRUNE_PID"
        wait_for_wake
        acquire_inhibitor
    done
    PRUNE_PID=""
fi
stop_sleep_guard

# --- finish: classify outcome ---

FINISHED=1
FINAL_STATE="idle"
if [[ "$RSYNC_EXIT" -eq 0 || "$RSYNC_EXIT" -eq 23 || "$RSYNC_EXIT" -eq 24 ]]; then
    LAST_PCT=100
    CURRENT_FILE=""
    if [[ "$RSYNC_EXIT" -ne 0 ]]; then
        ERROR_MSG="Partial transfer (exit $RSYNC_EXIT) — some files skipped"
    else
        ERROR_MSG=""
    fi
    HISTORY_EXIT=0  # tolerate 23/24 as success in history
    RSYNC_EXIT=0
else
    ERROR_MSG=$(tail -5 "$LOG_FILE" 2>/dev/null | grep -v '^===' | head -3 | tr '\n' ' ' | sed 's/  */ /g; s/^ *//; s/ *$//') || true
    FINAL_STATE="error"
    HISTORY_EXIT="$RSYNC_EXIT"
fi

# --- write history entry (must happen before streak compute) ---

FINISH_TIME="$(date -Iseconds)"
FINISH_EPOCH="$(date +%s)"
DURATION_SEC=$(( FINISH_EPOCH - START_EPOCH ))
HISTORY_FILE="$HISTORY_DIR/$JOB_NAME.jsonl"
printf '{"started":"%s","finished":"%s","duration_sec":%d,"exit_code":%d,"files_transferred":%d,"files_total":%d,"error":"%s"}\n' \
    "$START_TIME" "$FINISH_TIME" "$DURATION_SEC" "$HISTORY_EXIT" \
    "${FILES_XFRD:-0}" "${FILES_TOTAL:-0}" \
    "$(json_escape "${ERROR_MSG:-}")" \
    >> "$HISTORY_FILE"

# --- compute consecutive failure streak + detect suggested excludes ---

CONSECUTIVE_FAILURES=$(compute_failure_streak "$HISTORY_FILE")
SUGGESTED_EXCLUDES_JSON=$(suggest_excludes_from_log | to_json_array)

# --- write final status (with streak + suggestions) and notify ---

write_status "$FINAL_STATE"

if [[ "$FINAL_STATE" == "idle" ]]; then
    if [[ -n "$ERROR_MSG" ]]; then
        notify "✔ $JOB_NAME" "Backup completed with warnings"
    else
        notify "✔ $JOB_NAME" "Backup completed"
    fi
elif (( CONSECUTIVE_FAILURES >= FAILURE_STREAK_THRESHOLD )); then
    # Persistent failure — escalate to critical urgency, sticky until dismissed
    notify "✖ $JOB_NAME failed ${CONSECUTIVE_FAILURES}× in a row" \
        "${ERROR_MSG:-Backup failed (exit $HISTORY_EXIT)}" 2 0
else
    notify "✖ $JOB_NAME" "Backup failed (exit $HISTORY_EXIT)"
fi

rm -f "$PROGRESS_FILE"
echo "=== $(date -Iseconds) === finished (exit $RSYNC_EXIT) ===" >> "$LOG_FILE"

# --- rotate history (keeps file from growing unbounded) ---

rotate_history "$HISTORY_FILE" "$HISTORY_KEEP"

exit "$RSYNC_EXIT"
