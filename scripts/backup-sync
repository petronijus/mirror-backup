#!/usr/bin/env bash
# backup-sync — runs one backup job (rsync mirror or restic snapshot) with
# progress tracking and desktop notifications
# Usage: backup-sync <job-name> <src> <dst> [exclude-file] [archive-days]
#
# Engines (BACKUP_SYNC_ENGINE, set by the job's unit):
#   rsync   (default) mirrors <src> into <dst>.
#   restic  keeps snapshots in the repository <dst>/repo. <src> is a file
#           listing the paths to back up (mode "backup"), or the destination
#           of another restic job whose snapshots are copied (mode "copy").
#
# Scopes (BACKUP_SYNC_SCOPE):
#   user    (default) a systemd user unit of the desktop user.
#   system  a system unit run by root — backups that must read every file.
#           Notifications go to BACKUP_SYNC_NOTIFY_USER's session.
#
# Where things live (src/backup_monitor/paths.py resolves the same paths):
#   <dst>/.mirror-backup/          status.json, history.jsonl, backup.log, deferred
#       The job's state travels with its mirror: every machine or OS that
#       mounts the destination sees the same status and history, so a run done
#       on one of them counts on the others.
#   $XDG_RUNTIME_DIR/backup-sync/  <job>.pid, <job>.progress (user scope)
#   /run/mirror-backup/            the same for system jobs, and queue.lock —
#       the one queue every job of both scopes waits in, when the system part
#       is installed; without it, user jobs queue in their runtime dir.
#       Meaningful for this boot only.
#
# A run cut short by suspend, shutdown or logout is postponed, not failed:
# suspend stops the running rsync or restic and runs it again after wake, shutdown/logout leave a
# `deferred` marker that `mirror-backup resume` (mirror-backup-resume.service,
# once per user-manager start) turns back into a run — on whichever machine
# mounts the destination next.

set -euo pipefail

# Installs up to 0.5 called this from mirror-backup-resume.service. Only the
# app knows every job's destination, so the work moved there.
if [[ "${1:-}" == "--resume-deferred" ]]; then
    if command -v mirror-backup >/dev/null; then
        exec mirror-backup resume
    fi
    echo "backup-sync: --resume-deferred moved to 'mirror-backup resume', which is not installed" >&2
    exit 1
fi

SCOPE="${BACKUP_SYNC_SCOPE:-user}"
ENGINE="${BACKUP_SYNC_ENGINE:-rsync}"
case "$SCOPE" in
    user)   SYSTEMCTL_SCOPE=--user ;;
    system) SYSTEMCTL_SCOPE=--system ;;
    *) echo "backup-sync: unknown scope '$SCOPE'" >&2; exit 2 ;;
esac
case "$ENGINE" in
    rsync|restic) ;;
    *) echo "backup-sync: unknown engine '$ENGINE'" >&2; exit 2 ;;
esac

# The queue every job waits in. /run/mirror-backup comes from the system
# part's tmpfiles.d entry (root-owned, readable by all: flock needs no write
# access); BACKUP_SYNC_SYSTEM_RUN_DIR moves it for the tests.
SYSTEM_RUN_DIR="${BACKUP_SYNC_SYSTEM_RUN_DIR:-/run/mirror-backup}"
if [[ "$SCOPE" == system ]]; then
    RUNTIME_DIR="$SYSTEM_RUN_DIR"
else
    RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/backup-sync"
fi
mkdir -p "$RUNTIME_DIR"

JOB_NAME="${1:?Usage: backup-sync <job-name> <src> <dst> [exclude-file] [archive-days]}"
SRC="${2:?Missing source path}"
DST="${3:?Missing destination path}"
EXCLUDE_FILE="${4:-}"
ARCHIVE_DAYS="${5:-0}"

DST_DIR="${DST%/}"
[[ -n "$DST_DIR" ]] || DST_DIR=/
STATE_DIR="$DST_DIR/.mirror-backup"
STATUS_FILE="$STATE_DIR/status.json"
HISTORY_FILE="$STATE_DIR/history.jsonl"
LOG_FILE="$STATE_DIR/backup.log"
DEFERRED_FILE="$STATE_DIR/deferred"
MAINTENANCE_FILE="$STATE_DIR/maintenance.json"   # restic: when prune and check last ran
PID_FILE="$RUNTIME_DIR/$JOB_NAME.pid"
PROGRESS_FILE="$RUNTIME_DIR/$JOB_NAME.progress"
SUMMARY_FILE="$RUNTIME_DIR/$JOB_NAME.summary"     # restic: the backup's summary message
LOCK_FILE="$RUNTIME_DIR/queue.lock"
[[ -r "$SYSTEM_RUN_DIR/queue.lock" ]] && LOCK_FILE="$SYSTEM_RUN_DIR/queue.lock"
STATE_OK=0         # 1 once $STATE_DIR exists — nothing is written to $DST before

# restic jobs (see the restic engine below for what each one does)
RESTIC_MODE="${BACKUP_SYNC_RESTIC_MODE:-backup}"
RESTIC_KEEP="${BACKUP_SYNC_RESTIC_KEEP:-}"                # "--keep-daily 7 --keep-weekly 4 …"
RESTIC_PRUNE_DAYS="${BACKUP_SYNC_RESTIC_PRUNE_DAYS:-7}"   # 0 = never
RESTIC_CHECK_DAYS="${BACKUP_SYNC_RESTIC_CHECK_DAYS:-7}"   # 0 = never
RESTIC_CHECK_SUBSET="${BACKUP_SYNC_RESTIC_CHECK_SUBSET:-5%}"
PRE_COMMAND="${BACKUP_SYNC_PRE_COMMAND:-}"
RESTIC_PATHS=()    # mode backup: the paths listed in $SRC
NOTIFY_USER="${BACKUP_SYNC_NOTIFY_USER:-}"

HOST="${HOSTNAME:-$(uname -n)}"
RESTIC_HOST="${BACKUP_SYNC_RESTIC_HOST:-$HOST}"   # snapshots are taken, copied and thinned per host
BOOT_ID="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"

# logind endpoint the suspend guard listens to. Overridable only so the
# suspend path can be exercised against a fake logind on the session bus.
LOGIND_BUS="${BACKUP_SYNC_LOGIND_BUS:-system}"
LOGIND_NAME="${BACKUP_SYNC_LOGIND_NAME:-org.freedesktop.login1}"
STOP_GRACE="${BACKUP_SYNC_STOP_GRACE:-10}"   # seconds between SIGTERM and SIGKILL

CHILD_PID=""
PRUNE_PID=""
FLOCK_PID=""
INHIBIT_PID=""
SLEEP_GUARD=0      # 1 while the logind signal monitor (coprocess SLEEP_MON) runs
SLEEP_EVENT=""     # "start" / "end" after wait_tick saw PrepareForSleep
DEFERRED=0
DEFER_REASON=""    # "suspend" or "shutdown"
WAS_PAUSED=0       # the child was paused when a suspend stopped it
LAST_PCT=0
LAST_SPEED=""
LAST_ETA=""
CURRENT_FILE=""
FILES_XFRD=0
FILES_TOTAL=0
FILES_REMAINING=0
ERROR_MSG=""
SCAN_READ=""
FINISHED=0
IS_PAUSED=0
CONSECUTIVE_FAILURES=0
# Where the run is — see the progress filter below for the phases.
PHASE=""
PHASE_DONE=0
PHASE_TOTAL=0      # 0 = not known
PHASE_ESTIMATED=0  # 1 when PHASE_TOTAL is the previous run's count
PHASE_UNIT=""      # what PHASE_DONE counts when not files: bytes, packs, snapshots (restic)
PHASE_SEEN_EPOCH=0 # first sighting of the phase and its count then, for the ETA
PHASE_SEEN_DONE=0
COMPARED=0         # 1 once rsync compares files (state "running" from then on)
DIRS_SEEN=0
EST_FILES=0        # the previous successful run's file-list size …
EST_DIRS=0         # … and directory count, totals for the phases that have none
TRANSFER_SEQ=""    # rsync's transfer-progress line counter …
TRANSFER_EPOCH=0   # … and when it last moved: the speed is shown while it is fresh
PROGRESS_EOF=0
SUGGESTED_EXCLUDES_JSON="[]"
START_TIME="$(date -Iseconds)"
START_EPOCH="$(date +%s)"

HISTORY_KEEP="${BACKUP_SYNC_HISTORY_KEEP:-200}"
FAILURE_STREAK_THRESHOLD="${BACKUP_SYNC_STREAK_THRESHOLD:-3}"

# --- helpers ---

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

format_bytes() {
    local bytes=$1
    if (( bytes >= 1073741824 )); then
        local whole=$((bytes / 1073741824))
        local frac=$(( (bytes % 1073741824) * 10 / 1073741824 ))
        printf '%d.%d GB' "$whole" "$frac"
    elif (( bytes >= 1048576 )); then
        local whole=$((bytes / 1048576))
        local frac=$(( (bytes % 1048576) * 10 / 1048576 ))
        printf '%d.%d MB' "$whole" "$frac"
    elif (( bytes >= 1024 )); then
        printf '%d KB' $((bytes / 1024))
    else
        printf '%d B' "$bytes"
    fi
}

write_status() {
    local state="$1"
    local escaped_file escaped_error estimated=false
    (( STATE_OK )) || return 0
    (( PHASE_ESTIMATED )) && estimated=true
    escaped_file=$(json_escape "${CURRENT_FILE:-}")
    escaped_error=$(json_escape "${ERROR_MSG:-}")
    cat > "${STATUS_FILE}.tmp" <<-JEOF
{
  "job": "$(json_escape "$JOB_NAME")",
  "state": "$state",
  "progress": ${LAST_PCT:-0},
  "speed": "${LAST_SPEED:-}",
  "eta": "${LAST_ETA:-}",
  "current_file": "$escaped_file",
  "files_transferred": ${FILES_XFRD:-0},
  "files_total": ${FILES_TOTAL:-0},
  "files_remaining": ${FILES_REMAINING:-0},
  "phase": "${PHASE:-}",
  "phase_done": ${PHASE_DONE:-0},
  "phase_total": ${PHASE_TOTAL:-0},
  "phase_estimated": $estimated,
  "phase_unit": "${PHASE_UNIT:-}",
  "engine": "$ENGINE",
  "pid": $$,
  "rsync_pid": ${CHILD_PID:-0},
  "started": "$START_TIME",
  "updated": "$(date -Iseconds)",
  "scan_read": "${SCAN_READ:-}",
  "src": "$(json_escape "${SRC_LABEL:-$SRC}")",
  "dst": "$(json_escape "$DST")",
  "host": "$(json_escape "$HOST")",
  "boot_id": "$BOOT_ID",
  "error": "$escaped_error",
  "deferred_reason": "${DEFER_REASON:-}",
  "consecutive_failures": ${CONSECUTIVE_FAILURES:-0},
  "suggested_excludes": ${SUGGESTED_EXCLUDES_JSON:-[]}
}
JEOF
    mv -f "${STATUS_FILE}.tmp" "$STATUS_FILE"
}

# notify <summary> <body> [urgency] [expire_ms]
# urgency: 0=low, 1=normal (default), 2=critical
# expire_ms: 0 = never auto-dismiss (sticky), default 5000
notify() {
    local urgency="${3:-1}"
    local expire="${4:-5000}"
    local -a as_user=()
    # A system job has no session of its own: it speaks on the session bus of
    # the user it reports to, as that user, and stays quiet when that user is
    # not logged in.
    if [[ "$SCOPE" == system ]]; then
        local uid
        [[ -n "$NOTIFY_USER" ]] && uid=$(id -u -- "$NOTIFY_USER" 2>/dev/null) || return 0
        [[ -S "/run/user/$uid/bus" ]] || return 0
        as_user=(runuser -u "$NOTIFY_USER" -- env "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus")
    fi
    "${as_user[@]}" gdbus call --session \
        --dest=org.freedesktop.Notifications \
        --object-path=/org/freedesktop/Notifications \
        --method=org.freedesktop.Notifications.Notify \
        "Backup Sync" 0 "drive-harddisk" "$1" "$2" '[]' \
        "{'urgency': <byte $urgency>}" "$expire" \
        >/dev/null 2>&1 || true
}

# Count trailing failures in the history JSONL (newest entries first walk-back).
# Stops at the first successful entry. Echoes the streak count.
compute_failure_streak() {
    local file="$1"
    [[ -f "$file" ]] || { echo 0; return; }
    awk '
        { lines[NR] = $0 }
        END {
            streak = 0
            for (i = NR; i >= 1; i--) {
                if (lines[i] ~ /"exit_code":[[:space:]]*0,/) break
                if (lines[i] ~ /"exit_code":[[:space:]]*[0-9]+,/) streak++
            }
            print streak
        }
    ' "$file"
}

# Trim history file to last N entries (atomic via temp + rename).
rotate_history() {
    local file="$1" keep="$2"
    [[ -f "$file" ]] || return 0
    local lines
    lines=$(wc -l < "$file" 2>/dev/null) || return 0
    if (( lines > keep )); then
        tail -n "$keep" "$file" > "${file}.tmp" && mv -f "${file}.tmp" "$file"
    fi
}

# Scan the CURRENT run's log section for "Permission denied" rsync errors and
# emit deduped top-level paths (relative to SRC) that the user can add to the
# exclude file. Looks only at lines after the `=== <START_TIME> ===` marker so
# a previously-resolved error doesn't keep showing up.
# Output: one path per line on stdout (empty if no errors).
# Implemented as a single awk so empty matches don't trip pipefail+set -e.
suggest_excludes_from_log() {
    [[ -f "$LOG_FILE" ]] || return 0
    local src_clean="${SRC%/}"
    local marker="=== ${START_TIME} ==="
    if [[ "$ENGINE" == restic ]]; then
        # restic logs one JSON error per unreadable item, with its absolute path
        # — which is what a restic exclude file takes.
        awk -v marker="$marker" '
            !found { if (index($0, marker) == 1) found = 1; next }
            /"message_type":"error"/ && /permission denied/ {
                if (match($0, /"item":"([^"\\]|\\.)*"/)) {
                    path = substr($0, RSTART + 8, RLENGTH - 9)
                    gsub(/\\"/, "\"", path); gsub(/\\\\/, "\\", path)
                    seen[path] = 1
                }
            }
            END { for (s in seen) print s }
        ' "$LOG_FILE" | sort
        return 0
    fi
    awk -v marker="$marker" -v src="$src_clean" '
        BEGIN { srclen = length(src) + 1 }
        !found {
            if (index($0, marker) == 1) found = 1
            next
        }
        /Permission denied/ {
            if (match($0, /"[^"]+"/)) {
                path = substr($0, RSTART + 1, RLENGTH - 2)
                if (substr(path, 1, srclen) == src "/") {
                    rel = substr(path, srclen + 1)
                    slash = index(rel, "/")
                    top = (slash > 0) ? substr(rel, 1, slash - 1) : rel
                    if (top != "") seen[top] = 1
                }
            }
        }
        END { for (s in seen) print s }
    ' "$LOG_FILE" | sort
}

# Build a JSON array literal from newline-delimited stdin, e.g. "a\nb\n" → ["a","b"]
to_json_array() {
    local first=1 out="["
    while IFS= read -r item; do
        [[ -z "$item" ]] && continue
        local escaped
        escaped=$(json_escape "$item")
        if (( first )); then
            out+="\"$escaped\""
            first=0
        else
            out+=",\"$escaped\""
        fi
    done
    out+="]"
    printf '%s' "$out"
}

# --- progress ---
#
# A run goes through up to three phases, and rsync's own progress line covers
# none of them: it counts bytes copied against the size of everything, so an
# incremental run of a big mirror sits at 0 % from start to end.
#
#   listing   the sender walks the source         --info=flist2: "N files..."
#   deleting  a separate pass over the mirror's   --debug=del2: one
#             directories (--delete-before/after)  "delete_in_dir(dir)" each
#   checking  every entry of the file list is     -ii: one itemize line per
#             compared, and copied when it changed entry, unchanged ones too
#
# The filter below follows that output and appends a snapshot line to
# $PROGRESS_FILE for every message it counts; the status tick reads the last
# one (read_progress). A snapshot per message, not per so many: rsync can go
# quiet for minutes on a slow mount, and the count shown must be the one it
# stopped at. The file starts over every 20000 lines. Counting happens in awk
# because a run names every one of millions of files. Fields are separated by
# the unit separator (\x1f): rsync escapes control characters in the names it
# itemizes, and unlike a tab it keeps empty fields apart when bash reads them.
PROGRESS_AWK='
function dump(eof) {
    if (written++ >= 20000) { close(out); written = 1 }   # reopened, it starts empty
    printf "%s\037%d\037%d\037%d\037%d\037%s\037%d\037%d\037%s\037end\n", \
        phase, done, files_total, dirs, xfr, speed, p2n, eof, current > out
    fflush(out)
}
function enter(p) { phase = p; done = 0; current = ""; dump(0) }
BEGIN { phase = "listing"; dump(0) }
/^ *[0-9]+ files\.\.\.$/ { done = $1 + 0; dump(0); next }
/^[0-9]+ files to consider$/ { files_total = $1 + 0; enter("checking"); next }
/^deleting in / { enter("deleting"); next }
/^delete_in_dir\(/ {
    if (phase != "deleting") next   # --delete-during: part of the comparison
    done++
    current = substr($0, 15, length($0) - 15)
    dump(0)
    next
}
/^[<>ch.][fdLDS]......... / {
    if (phase != "checking") enter("checking")
    done++
    if (substr($0, 2, 1) == "d") dirs++
    current = substr($0, 13)
    if (substr($0, 2, 1) == "L") sub(/ -> .*$/, "", current)
    dump(0)
    next
}
/^ +[0-9][^ ]* +[0-9]+% / {
    speed = $3; p2n++
    if (match($0, /xfr#[0-9]+/)) xfr = substr($0, RSTART + 4, RLENGTH - 4) + 0
    dump(0)
    next
}
END { dump(1) }
'

# mawk reads a pipe in whole blocks unless it runs interactive, which would
# hold the snapshot back by thousands of lines; gawk passes lines on as they come.
AWK_LINES=(awk)
case "$(awk -W version 2>&1)" in
    mawk*) AWK_LINES=(awk -W interactive) ;;
esac
PROGRESS_FILTER=("${AWK_LINES[@]}" -v "out=$PROGRESS_FILE" "$PROGRESS_AWK")

# The filter's last snapshot into the status variables. Returns 1 while there
# is none yet, or when the file was caught starting over or mid-line.
read_progress() {
    local line phase done files_total dirs xfr speed p2n eof current end
    local now permille left
    line=$(tail -n 1 "$PROGRESS_FILE" 2>/dev/null) || return 1
    IFS=$'\x1f' read -r phase done files_total dirs xfr speed p2n eof current end <<< "$line"
    [[ "$end" == end ]] || return 1
    printf -v now '%(%s)T' -1

    if [[ "$phase" != "$PHASE" ]]; then
        PHASE=$phase
        PHASE_SEEN_EPOCH=$now
        PHASE_SEEN_DONE=$done
    fi
    PHASE_DONE=$done
    FILES_TOTAL=$files_total
    FILES_XFRD=$xfr
    DIRS_SEEN=$dirs
    CURRENT_FILE=$current
    PROGRESS_EOF=$eof
    [[ "$PHASE" == checking ]] && COMPARED=1

    PHASE_ESTIMATED=0
    case "$PHASE" in
        listing)
            PHASE_TOTAL=$EST_FILES PHASE_ESTIMATED=1 ;;
        deleting)
            # After the comparison (--delete-after) this run has counted the
            # directories itself; before it, the previous run's count stands in.
            if (( COMPARED && DIRS_SEEN )); then
                PHASE_TOTAL=$DIRS_SEEN
            else
                PHASE_TOTAL=$EST_DIRS PHASE_ESTIMATED=1
            fi ;;
        checking)
            PHASE_TOTAL=$FILES_TOTAL
            FILES_REMAINING=$(( FILES_TOTAL > PHASE_DONE ? FILES_TOTAL - PHASE_DONE : 0 )) ;;
        *)
            PHASE_TOTAL=0 ;;
    esac
    (( PHASE_TOTAL )) || PHASE_ESTIMATED=0

    LAST_PCT=0
    if (( PHASE_TOTAL )); then
        permille=$(( PHASE_DONE * 1000 / PHASE_TOTAL ))
        (( permille <= 1000 )) || permille=1000
        # An estimate is off either way; it never claims the phase finished.
        (( ! PHASE_ESTIMATED || permille <= 990 )) || permille=990
        LAST_PCT="$((permille / 10)).$((permille % 10))"
    fi

    # From the average pace since the phase was first seen (or resumed).
    LAST_ETA=""
    if (( PHASE_TOTAL > PHASE_DONE && PHASE_DONE > PHASE_SEEN_DONE && now - PHASE_SEEN_EPOCH >= 10 )); then
        left=$(( (PHASE_TOTAL - PHASE_DONE) * (now - PHASE_SEEN_EPOCH) / (PHASE_DONE - PHASE_SEEN_DONE) ))
        printf -v LAST_ETA '%d:%02d:%02d' $((left / 3600)) $((left % 3600 / 60)) $((left % 60))
    fi

    # rsync repeats its transfer line only while it copies; a speed from a
    # copy that ended minutes ago would describe nothing.
    if [[ "$p2n" != "$TRANSFER_SEQ" ]]; then
        TRANSFER_SEQ=$p2n
        TRANSFER_EPOCH=$now
    fi
    LAST_SPEED=""
    (( now - TRANSFER_EPOCH > 10 )) || LAST_SPEED=$speed
    return 0
}

# "scanning" until rsync compares files, "running" from then on.
write_active_status() {
    if (( COMPARED )); then
        write_status "running"
    else
        write_status "scanning"
    fi
}

# Totals of the previous successful run, "<files> <dirs>": the source listing
# and a delete pass report no total of their own, and a mirror changes little
# between runs.
previous_totals() {
    [[ -f "$HISTORY_FILE" ]] || return 0
    awk '/"exit_code":[[:space:]]*0[,}]/ && /"files_total":[[:space:]]*[1-9]/ { line = $0 }
        END {
            if (line == "") exit
            f = line; sub(/.*"files_total":[[:space:]]*/, "", f); sub(/[^0-9].*/, "", f)
            d = 0
            if (line ~ /"dirs_total":/) { d = line; sub(/.*"dirs_total":[[:space:]]*/, "", d); sub(/[^0-9].*/, "", d) }
            print f + 0, d + 0
        }' "$HISTORY_FILE"
}

# --- restic progress ---
#
# A restic run is a row of commands, each one a phase (see the restic engine).
# `restic backup --json` reports a status message per progress tick (bytes and
# files done, of a total it keeps growing while it scans) and a summary at the
# end; the other commands print text lines "[0:12] 45.00%  9 / 20 packs".
# RESTIC_PROGRESS_FPS makes restic report while its output is not a terminal.
# The filter turns both into one snapshot line per message, fields separated by
# \x1f: phase, done, total, unit, files done, files total, seconds left
# (empty: unknown), current file, end of output. The summary message goes to
# $SUMMARY_FILE as it is, any other line into the log. Flat JSON is matched field by field: restic writes
# every message on a line of its own, and these fields are never nested.
RESTIC_PROGRESS_AWK='
function dump(eof) {
    if (written++ >= 20000) { close(out); written = 1 }
    printf "%s\037%.0f\037%.0f\037%s\037%.0f\037%.0f\037%s\037%s\037%d\037end\n", \
        phase, done, total, unit, fdone, ftotal, left, current, eof > out
    fflush(out)
}
function num(key) {
    if (!match($0, "\"" key "\":[0-9.eE+-]+")) return -1
    return substr($0, RSTART + length(key) + 3, RLENGTH - length(key) - 3) + 0
}
function first_current(   s) {
    if (!match($0, /"current_files":\["([^"\\]|\\.)*"/)) return ""
    s = substr($0, RSTART + 18, RLENGTH - 19)
    gsub(/\\"/, "\"", s); gsub(/\\\\/, "\\", s)
    return s
}
BEGIN { unit = ""; left = ""; dump(0) }
/^\{"message_type":"status"/ {
    done = num("bytes_done"); total = num("total_bytes"); unit = "bytes"
    fdone = num("files_done"); ftotal = num("total_files")
    if (done < 0) done = 0; if (total < 0) total = 0
    if (fdone < 0) fdone = 0; if (ftotal < 0) ftotal = 0
    left = num("seconds_remaining"); if (left < 0) left = ""
    current = first_current()
    dump(0)
    next
}
/^\{"message_type":"summary"/ { print > summary; fflush(summary); next }
/^\[[0-9:]+\] +[0-9.]+% +[0-9]+ \/ [0-9]+ / {
    done = $3 + 0; total = $5 + 0; unit = $6; left = ""; current = ""
    dump(0)
    next
}
# What restic reports besides progress — "snapshot … saved", what prune
# removed, what check found — belongs in the log.
/[^[:space:]]/ { print >> logfile; fflush(logfile) }
END { dump(1) }
'

# The restic filter's last snapshot into the status variables; returns 1 while
# there is none yet, or when the file was caught starting over or mid-line.
RESTIC_BYTES_SEEN=0   # bytes done at the previous tick, and when: the speed
RESTIC_BYTES_EPOCH=0
read_restic_progress() {
    local line phase done total unit fdone ftotal left current eof end
    local now permille
    line=$(tail -n 1 "$PROGRESS_FILE" 2>/dev/null) || return 1
    IFS=$'\x1f' read -r phase done total unit fdone ftotal left current eof end <<< "$line"
    [[ "$end" == end ]] || return 1
    printf -v now '%(%s)T' -1

    # A new phase, a new counter (check counts snapshots, then packs), or one
    # that started over (copy counts the packs of each snapshot anew).
    if [[ "$phase" != "$PHASE" || "$unit" != "$PHASE_UNIT" ]] || (( done < PHASE_DONE )); then
        PHASE=$phase PHASE_UNIT=$unit
        PHASE_SEEN_EPOCH=$now PHASE_SEEN_DONE=$done
        RESTIC_BYTES_SEEN=$done RESTIC_BYTES_EPOCH=$now
        LAST_SPEED=""
    fi
    PHASE_DONE=$done PHASE_TOTAL=$total PHASE_ESTIMATED=0
    CURRENT_FILE=$current
    PROGRESS_EOF=$eof
    if [[ "$unit" == bytes ]]; then
        FILES_XFRD=$fdone FILES_TOTAL=$ftotal
        FILES_REMAINING=$(( ftotal > fdone ? ftotal - fdone : 0 ))
        if (( now - RESTIC_BYTES_EPOCH >= 3 )); then
            LAST_SPEED="$(format_bytes $(( (done - RESTIC_BYTES_SEEN) / (now - RESTIC_BYTES_EPOCH) )))/s"
            RESTIC_BYTES_SEEN=$done RESTIC_BYTES_EPOCH=$now
        fi
    fi

    LAST_PCT=0
    if (( total )); then
        permille=$(( done * 1000 / total ))
        (( permille <= 1000 )) || permille=1000
        LAST_PCT="$((permille / 10)).$((permille % 10))"
    fi

    # restic's own estimate where it gives one, else the phase's average pace.
    LAST_ETA=""
    if [[ -z "$left" ]] && (( total > done && done > PHASE_SEEN_DONE && now - PHASE_SEEN_EPOCH >= 10 )); then
        left=$(( (total - done) * (now - PHASE_SEEN_EPOCH) / (done - PHASE_SEEN_DONE) ))
    fi
    [[ -n "$left" ]] && printf -v LAST_ETA '%d:%02d:%02d' $((left / 3600)) $((left % 3600 / 60)) $((left % 60))
    return 0
}

# --- stopping the child / postponing the run ---

descendants() {
    local child
    for child in $(pgrep -P "$1" 2>/dev/null); do
        echo "$child"
        descendants "$child"
    done
}

# "pid:starttime" for $1 and every process below it. The start time pins the
# identity, so a PID the kernel hands out again is never mistaken for ours.
proc_tree() {
    local pid stat fields
    for pid in "$1" $(descendants "$1"); do
        { stat=$(< "/proc/$pid/stat"); } 2>/dev/null || continue
        read -ra fields <<< "${stat##*) }"   # fields after "(comm) "
        echo "$pid:${fields[19]}"
    done
}

# Any process of a proc_tree snapshot still alive?
tree_alive() {
    local entry pid stat fields
    for entry in "$@"; do
        pid="${entry%%:*}"
        { stat=$(< "/proc/$pid/stat"); } 2>/dev/null || continue
        read -ra fields <<< "${stat##*) }"
        [[ "${fields[19]}" == "${entry#*:}" && "${fields[0]}" != Z ]] && return 0
    done
    return 1
}

# Stop background child $1 and everything it forked (a local rsync transfer
# is a sender, receiver and generator trio), and wait until all of them are
# gone — for a suspend, any survivor could still be inside a FUSE request.
# SIGTERM first so rsync removes its temp files; SIGCONT because a paused
# (SIGSTOPped) rsync cannot act on anything; SIGKILL for whatever is still
# there after the grace period.
stop_tree() {
    local root="$1" entry waited=0
    local -a tree=() pids=()
    [[ -n "$root" ]] && kill -0 "$root" 2>/dev/null || return 0
    mapfile -t tree < <(proc_tree "$root")
    for entry in "${tree[@]}"; do pids+=("${entry%%:*}"); done
    kill -TERM "${pids[@]}" 2>/dev/null || true
    kill -CONT "${pids[@]}" 2>/dev/null || true
    while tree_alive "${tree[@]}" && (( waited < STOP_GRACE * 10 )); do
        sleep 0.1
        waited=$((waited + 1))
    done
    for entry in "${tree[@]}"; do
        tree_alive "$entry" && kill -KILL "${entry%%:*}" 2>/dev/null
    done
    wait "$root" 2>/dev/null || true
}

stop_child() {
    stop_tree "$CHILD_PID"
    IS_PAUSED=0
}

# True while the user's service manager or the whole system is going down —
# shutdown, reboot, or logout of a user without lingering. A SIGTERM arriving
# then is not somebody pressing Stop, so the run is postponed instead of failed.
session_stopping() {
    local scope state
    for scope in --user --system; do
        state=$(timeout 5 systemctl "$scope" is-system-running 2>/dev/null) || true
        [[ "$state" == stopping ]] && return 0
    done
    return 1
}

defer() {
    DEFERRED=1
    DEFER_REASON="$1"
    printf '{"reason": "%s", "since": "%s"}\n' "$1" "$(date -Iseconds)" > "$DEFERRED_FILE"
}

# --- suspend guard ---
#
# rsync or restic blocked inside a FUSE request (NTFS via ntfs-3g, rclone, sshfs …)
# cannot be frozen for suspend: the freezer stops the FUSE daemon as well, the
# request never completes, and after 20 s the kernel aborts the suspend. So
# while the child runs we hold a logind *delay* inhibitor. logind announces the
# suspend with PrepareForSleep(true) and waits for us; the FUSE daemon is still
# running at that point, the pending request completes, the child exits, and only
# then is the inhibitor released. After PrepareForSleep(false) the run starts
# over. Needs gdbus and systemd-inhibit; without them the guard stays off.

start_sleep_guard() {
    command -v gdbus >/dev/null && command -v systemd-inhibit >/dev/null \
        && command -v stdbuf >/dev/null || return 0
    coproc SLEEP_MON {
        exec stdbuf -oL gdbus monitor "--$LOGIND_BUS" --dest "$LOGIND_NAME" \
            --object-path /org/freedesktop/login1 2>/dev/null 9>&-
    }
    # gdbus prints the owner line once its match rule is in place; taking the
    # inhibitor any earlier could hold up a suspend whose signal we then miss.
    local line
    while [[ -n "${SLEEP_MON[0]:-}" ]] && IFS= read -r -t 5 -u "${SLEEP_MON[0]}" line; do
        if [[ "$line" == "The name $LOGIND_NAME is owned by "* ]]; then
            SLEEP_GUARD=1
            return 0
        fi
    done
    stop_sleep_guard
}

stop_sleep_guard() {
    release_inhibitor
    if [[ -n "${SLEEP_MON_PID:-}" ]]; then
        kill "$SLEEP_MON_PID" 2>/dev/null || true
        wait "$SLEEP_MON_PID" 2>/dev/null || true
    fi
    SLEEP_GUARD=0
}

acquire_inhibitor() {
    (( SLEEP_GUARD )) && [[ -z "$INHIBIT_PID" ]] || return 0
    systemd-inhibit --what=sleep --mode=delay --who="Mirror Backup" \
        --why="Stopping $JOB_NAME before suspend" sleep infinity 9>&- &
    INHIBIT_PID=$!
}

release_inhibitor() {
    [[ -n "$INHIBIT_PID" ]] || return 0
    kill "$INHIBIT_PID" 2>/dev/null || true
    wait "$INHIBIT_PID" 2>/dev/null || true
    INHIBIT_PID=""
}

# Wait up to $1 seconds (default 2) — the status-refresh tick — and report a
# logind sleep transition in SLEEP_EVENT. A trapped signal does not cut
# `read -t` short, so the tick also bounds how long a stop request waits.
wait_tick() {
    local timeout="${1:-2}" line rc=0
    SLEEP_EVENT=""
    # bash drops the SLEEP_MON array once the coprocess has exited.
    if (( SLEEP_GUARD )) && [[ -z "${SLEEP_MON[0]:-}" ]]; then
        stop_sleep_guard
    fi
    if (( SLEEP_GUARD )); then
        IFS= read -r -t "$timeout" -u "${SLEEP_MON[0]}" line || rc=$?
        if (( rc == 0 )); then
            case "$line" in
                *".PrepareForSleep (true,)"*)  SLEEP_EVENT="start" ;;
                *".PrepareForSleep (false,)"*) SLEEP_EVENT="end" ;;
            esac
            return 0
        fi
        (( rc > 128 )) && return 0    # timed out, or a trapped signal
        stop_sleep_guard              # EOF: the monitor died, fall back to polling
    fi
    sleep "$timeout" &
    wait $! 2>/dev/null || true
}

# --- networked source or destination (NFS, SMB, sshfs, rclone …) ---
#
# Timers with Persistent=true start a missed run right after boot or wake,
# while the network is still coming up — and a suspend in the middle of a run
# brings it back the same way. A run first waits until every server behind its
# source and destination answers, at most NETWORK_WAIT seconds.

NETWORK_WAIT="${BACKUP_SYNC_NETWORK_WAIT:-120}"
DOWN_REASON=""

# The filesystem behind each mount point: fstype, source and options, keyed by
# mount point. The mount table wins, except where it holds only an automount
# trap (autofs) — then fstab says what gets mounted there on first access.
declare -A MNT_FSTYPE=() MNT_SOURCE=() MNT_OPTS=()
load_mount_tables() {
    local table target fstype source opts
    local -a args
    MNT_FSTYPE=() MNT_SOURCE=() MNT_OPTS=()
    for table in fstab live; do
        args=(-rn -o "TARGET,FSTYPE,SOURCE,OPTIONS")
        [[ "$table" == fstab ]] && args=(-s ${BACKUP_SYNC_FSTAB:+-F "$BACKUP_SYNC_FSTAB"} "${args[@]}")
        while read -r target fstype source opts; do
            target=$(printf '%b' "$target")   # -r escapes blanks as \x20
            [[ "$fstype" == autofs && -n "${MNT_FSTYPE[$target]:-}" ]] && continue
            MNT_FSTYPE[$target]="$fstype"
            MNT_SOURCE[$target]=$(printf '%b' "$source")
            MNT_OPTS[$target]="$opts"
        done < <(findmnt "${args[@]}" 2>/dev/null || true)
    done
}

# host[:…] or [v6-address][:…] → the bare host.
host_of() {
    if [[ "$1" == \[* ]]; then
        local host="${1#\[}"
        printf '%s\n' "${host%%\]*}"
    else
        printf '%s\n' "${1%%:*}"
    fi
}

# What to probe for the mount at $1: "host port" for a server that can be
# asked directly, "-" where only the network as a whole can be checked,
# nothing for a local filesystem. A port= mount option overrides the default.
probe_target() {
    local source="${MNT_SOURCE[$1]}" opts=",${MNT_OPTS[$1]},"
    local host port
    case "${MNT_FSTYPE[$1]}" in
        nfs|nfs4)         host=$(host_of "$source"); port=2049 ;;
        cifs|smb3)        source="${source#//}"; host="${source%%/*}"; port=445 ;;
        fuse.sshfs|sshfs) host=$(host_of "${source#*@}"); port=22 ;;
        ceph|glusterfs|9p|fuse.rclone|fuse.s3fs|fuse.gcsfuse)
            echo "-"; return ;;
        *) return ;;
    esac
    if [[ "$opts" =~ ,port=([0-9]+), ]] && (( BASH_REMATCH[1] > 0 )); then
        port="${BASH_REMATCH[1]}"
    fi
    echo "$host $port"
}

# Probe targets of the mounts on the way from the absolute path $1 up to /.
probe_targets_along() {
    local dir="$1"
    while :; do
        [[ -n "${MNT_FSTYPE[$dir]:-}" ]] && probe_target "$dir"
        [[ "$dir" == / ]] && return 0
        dir=$(dirname -- "$dir")
    done
}

# Probe targets of the networked mounts behind path $1. The path is walked as
# written first, without looking it up: below an automount point a lookup
# starts the very mount that has to wait for the network. Only a path with no
# networked mount on it as written is resolved — a symlink may lead onto one.
network_servers() {
    local targets
    targets=$(probe_targets_along "$(realpath -s -m -- "$1")")
    [[ -n "$targets" ]] || targets=$(probe_targets_along "$(realpath -m -- "$1")")
    [[ -z "$targets" ]] || sort -u <<< "$targets"   # NFSv4 submounts repeat the server
}

# Does probe target "$1 [$2]" answer right now? Sets DOWN_REASON when not.
reachable() {
    if [[ "$1" == - ]]; then
        command -v nm-online >/dev/null || return 0   # nothing to ask
        nm-online -q -t 0 && return 0
        DOWN_REASON="the network is offline"
    else
        timeout 3 bash -c 'exec 3<>"/dev/tcp/$1/$2"' _ "$1" "$2" 2>/dev/null && return 0
        DOWN_REASON="$1 does not answer on port $2"
    fi
    return 1
}

# Does a server behind path $1 not answer? DOWN_REASON says which.
unreachable() {
    local target
    load_mount_tables
    while read -r target; do
        # shellcheck disable=SC2086  # "host port" is two arguments
        reachable $target </dev/null || return 0
    done < <(network_servers "$1")
    return 1
}

# Wait until every server behind the source and the destination answers.
# Returns 1 at the deadline; the caller decides what a server still down means.
wait_for_network() {
    local deadline=$((SECONDS + NETWORK_WAIT)) waiting=0 target down
    local -a targets
    load_mount_tables
    local path
    mapfile -t targets < <(for path in "$SRC" "$DST" ${RESTIC_PATHS[@]+"${RESTIC_PATHS[@]}"}; do
        network_servers "$path"; done | sort -u)
    while :; do
        down=0
        for target in "${targets[@]}"; do
            # shellcheck disable=SC2086
            reachable $target || { down=1; break; }
        done
        if (( ! down )); then
            (( waiting )) && echo "$JOB_NAME: network is back" >&2
            return 0
        fi
        (( SECONDS < deadline )) || return 1
        if (( ! waiting )); then
            echo "$JOB_NAME: waiting up to ${NETWORK_WAIT}s for the network — $DOWN_REASON" >&2
            waiting=1
        fi
        wait_tick   # short ticks keep a Stop during the wait responsive
        handle_signals
    done
}

# Let the announced suspend proceed and return once the system is back.
wait_for_wake() {
    release_inhibitor
    until [[ "$SLEEP_EVENT" == "end" ]] || (( ! SLEEP_GUARD )); do
        wait_tick   # short ticks keep a Stop during the wait responsive
        handle_signals
    done
    # Right after wake the network is typically still reconnecting. A server
    # still down then fails the rerun with rsync's own error.
    wait_for_network || true
}

# Watch background child $1 until it exits, running $2 every tick. Returns 1
# as soon as a suspend is announced (the caller then stops the child), 0 once
# the child has finished on its own.
supervise() {
    local pid="$1" on_tick="$2"
    while kill -0 "$pid" 2>/dev/null; do
        "$on_tick"
        wait_tick
        handle_signals
        [[ "$SLEEP_EVENT" == "start" ]] && return 1
    done
    return 0
}

no_tick() { :; }

# The child was cut short by an announced suspend. Even a paused one is stopped:
# its processes are not guaranteed to be parked outside a FUSE request.
stop_child_for_suspend() {
    WAS_PAUSED=$IS_PAUSED
    stop_child
    rm -f "$PROGRESS_FILE"
    defer suspend   # the marker survives a machine that never wakes (hibernate, power off)
    write_status "deferred"
    echo "=== $(date -Iseconds) === stopped for suspend, restarts after wake ===" >> "$LOG_FILE"
    notify "⏸ $JOB_NAME" "Stopped for suspend — restarts after wake"
    wait_for_wake
    rm -f "$DEFERRED_FILE"
    DEFERRED=0
    DEFER_REASON=""
}

# --- signal handlers ---
#
# Traps only record what arrived; the work happens at the checkpoints in the
# main flow (handle_signals). A trap runs *inside* whatever builtin it
# interrupted, and when that is `read -t` — the suspend guard's tick — a
# handler that outlives the read's timeout makes bash longjmp into a dead
# stack frame and abort.

TERM_REQUESTED=0
PAUSE_REQUEST=""   # "pause" / "resume", the latest one wins

# The whole child tree: stopping only rsync's sender would leave the receiver and
# generator running, and possibly sitting in a FUSE request.
pause_child() {
    [[ -n "$CHILD_PID" ]] && kill -0 "$CHILD_PID" 2>/dev/null || return 0
    # shellcheck disable=SC2046
    kill -STOP "$CHILD_PID" $(descendants "$CHILD_PID") 2>/dev/null || true
    IS_PAUSED=1
    write_status "paused"
}

resume_child() {
    [[ -n "$CHILD_PID" ]] && kill -0 "$CHILD_PID" 2>/dev/null || return 0
    # shellcheck disable=SC2046
    kill -CONT "$CHILD_PID" $(descendants "$CHILD_PID") 2>/dev/null || true
    IS_PAUSED=0
    # The pause says nothing about the child's pace: the ETA starts measuring anew.
    printf -v PHASE_SEEN_EPOCH '%(%s)T' -1
    PHASE_SEEN_DONE=$PHASE_DONE
    write_active_status
}

handle_signals() {
    if (( TERM_REQUESTED )); then
        on_terminate
    fi
    case "$PAUSE_REQUEST" in
        pause)
            if (( ! IS_PAUSED )) && [[ -n "$CHILD_PID" ]] && kill -0 "$CHILD_PID" 2>/dev/null; then
                pause_child
                notify "⏸ $JOB_NAME" "Backup paused"
            fi
            ;;
        resume)
            if (( IS_PAUSED )) && [[ -n "$CHILD_PID" ]] && kill -0 "$CHILD_PID" 2>/dev/null; then
                resume_child
                notify "▶ $JOB_NAME" "Backup resumed"
            fi
            ;;
    esac
    PAUSE_REQUEST=""
}

# SIGTERM / SIGINT / SIGHUP, acted on from handle_signals.
on_terminate() {
    trap '' TERM INT HUP
    if [[ -n "$FLOCK_PID" ]]; then
        kill "$FLOCK_PID" 2>/dev/null || true
    fi
    stop_child
    stop_tree "$PRUNE_PID"
    if session_stopping; then
        defer shutdown
    else
        # A deliberate stop cancels the run, including one waiting out a suspend.
        rm -f "$DEFERRED_FILE"
        DEFERRED=0
        DEFER_REASON=""
    fi
    exit 143
}

cleanup() {
    stop_child
    stop_tree "$PRUNE_PID"
    stop_sleep_guard
    rm -f "$PID_FILE" "$PROGRESS_FILE" "${PROGRESS_FILE}.tmp" "${STATUS_FILE}.tmp"
    if (( DEFERRED )); then
        write_status "deferred"
        echo "=== $(date -Iseconds) === postponed by $DEFER_REASON, restarts at next start ===" >> "$LOG_FILE"
        # No notification: the desktop session is going away with us.
    elif [[ "$FINISHED" -eq 0 ]]; then
        ERROR_MSG="Backup interrupted"
        write_status "error"
        notify "⏹ $JOB_NAME" "Backup interrupted"
    fi
}

trap 'PAUSE_REQUEST=pause' USR1
trap 'PAUSE_REQUEST=resume' USR2
trap 'TERM_REQUESTED=1' TERM INT HUP
trap cleanup EXIT

# --- preflight checks ---

# preflight_fail <message>: this run cannot start. The status is written only
# when the destination is usable — never into an unmounted mount point.
preflight_fail() {
    ERROR_MSG="$1"
    echo "$JOB_NAME: $ERROR_MSG" >&2
    write_status "error"
    notify "✖ $JOB_NAME" "$ERROR_MSG"
    FINISHED=1
    exit 1
}

# Every mount point fstab or a mount unit declares on the way from $1 up to /
# must be mounted. An unmounted mount point is an empty directory on the parent
# filesystem: as a destination it would fill the system disk with a second
# copy of the source, as a source it would make rsync --delete empty the mirror
# and leave a restic snapshot without the data.
# BACKUP_SYNC_FSTAB and BACKUP_SYNC_UNIT_DIRS point the lookup elsewhere — for
# the tests only.
MOUNT_UNIT_DIRS="${BACKUP_SYNC_UNIT_DIRS:-/etc/systemd/system /usr/lib/systemd/system}"
declared_mount() {
    local unit dir
    findmnt -s ${BACKUP_SYNC_FSTAB:+-F "$BACKUP_SYNC_FSTAB"} -n -M "$1" >/dev/null 2>&1 && return 0
    [[ "$1" == / ]] && return 1
    unit="$(systemd-escape --path -- "$1" 2>/dev/null).mount" || return 1
    for dir in $MOUNT_UNIT_DIRS; do
        [[ -f "$dir/$unit" ]] && return 0
    done
    return 1
}
UNMOUNTED=""
require_mounted() {
    local dir
    dir=$(realpath -m -- "$1")
    while :; do
        if declared_mount "$dir" && ! mountpoint -q -- "$dir" 2>/dev/null; then
            UNMOUNTED="$dir"
            return 1
        fi
        [[ "$dir" == / ]] && return 0
        dir=$(dirname -- "$dir")
    done
}

# Anything in $1 besides the directories backup-sync keeps there itself?
has_entries() {
    [[ -n "$(find "$1" -mindepth 1 -maxdepth 1 ! -name .mirror-backup ! -name .archive \
        -print -quit 2>/dev/null)" ]]
}

# restic, mode backup: $SRC lists the paths, one per line (# comments). Read
# before anything waits on them; checked once the status can say what is wrong.
SRC_DIR="${SRC%/}"
[[ -n "$SRC_DIR" ]] || SRC_DIR=/
if [[ "$ENGINE" == restic && "$RESTIC_MODE" == backup && -r "$SRC" ]]; then
    mapfile -t RESTIC_PATHS < <(sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; /^(#|$)/d' -- "$SRC")
    if (( ${#RESTIC_PATHS[@]} )); then
        printf -v SRC_LABEL '%s, ' "${RESTIC_PATHS[@]}"
        SRC_LABEL="${SRC_LABEL%, }"
    fi
fi

# A server still down after the wait fails the run by name — rather than as a
# mount that is missing or an automount that turns up empty.
wait_for_network || true
unreachable "$DST_DIR" && preflight_fail "Destination unreachable: $DOWN_REASON"
require_mounted "$DST_DIR" || preflight_fail "Destination not mounted: $UNMOUNTED"
# Never created here: a missing destination is a missing mount far more often
# than a new job, and the app creates new destinations when it saves the job.
[[ -d "$DST_DIR" ]] || preflight_fail "Destination not found: $DST (not mounted?)"
mkdir -p "$STATE_DIR" 2>/dev/null || preflight_fail "Cannot write to the destination: $STATE_DIR"
STATE_OK=1

# require_source <path>: reachable, every fstab mount on the way mounted, there.
require_source() {
    unreachable "$1" && preflight_fail "Source unreachable: $DOWN_REASON"
    require_mounted "$1" || preflight_fail "Source not mounted: $UNMOUNTED"
    [[ -e "$1" ]] || preflight_fail "Source not found: $1"
}

if [[ "$ENGINE" == rsync ]]; then
    require_source "$SRC"
    [[ -d "$SRC" ]] || preflight_fail "Source not found: $SRC"
    if [[ "${BACKUP_SYNC_DELETE_MODE:-before}" != disabled ]] && ! has_entries "$SRC" \
            && has_entries "$DST_DIR"; then
        preflight_fail "Source is empty but the mirror is not — refusing to delete the whole backup ($SRC not mounted?)"
    fi
else
    command -v restic >/dev/null || preflight_fail "restic is not installed"
    [[ -r "${RESTIC_PASSWORD_FILE:-}" ]] \
        || preflight_fail "Repository password not readable: ${RESTIC_PASSWORD_FILE:-RESTIC_PASSWORD_FILE is not set}"
    # Never initialised here, for the same reason the destination is never
    # created: an empty directory where a repository should be is a missing
    # mount, or the wrong disk, far more often than a new job.
    [[ -f "$DST_DIR/repo/config" ]] \
        || preflight_fail "No restic repository in $DST_DIR/repo — initialise it first (sudo /usr/local/lib/mirror-backup/mirror-backup system init $JOB_NAME)"
    case "$RESTIC_MODE" in
        backup)
            [[ -r "$SRC" ]] || preflight_fail "Path list not found: $SRC"
            (( ${#RESTIC_PATHS[@]} )) || preflight_fail "No paths to back up in $SRC"
            # Each path on its own: a bind mount that did not come up is an
            # empty directory, and a snapshot of it would, after enough runs,
            # leave retention nothing but snapshots without that data.
            for path in "${RESTIC_PATHS[@]}"; do
                [[ "$path" == /* ]] || preflight_fail "Not an absolute path in $SRC: $path"
                require_source "$path"
            done ;;
        copy)
            require_source "$SRC_DIR"
            [[ -f "$SRC_DIR/repo/config" ]] || preflight_fail "No restic repository to copy from in $SRC_DIR/repo" ;;
        *)
            preflight_fail "Unknown restic mode: $RESTIC_MODE" ;;
    esac
fi

# --- a scheduled run another machine already made ---
#
# systemd sets TRIGGER_UNIT for a service its timer started. Persistent timers
# catch up on runs missed while this install was down — but the history is
# shared, and when another machine (the other OS of a dual boot, typically)
# succeeded after the last scheduled time, the catch-up would only repeat it.
# The slot counts as covered when the first scheduled time after the start of
# the last successful run still lies in the future.

# The timer's calendar expressions, one per line.
trigger_calendars() {
    if [[ -n "${BACKUP_SYNC_SCHEDULE:-}" ]]; then   # tests
        printf '%s\n' "$BACKUP_SYNC_SCHEDULE"
        return
    fi
    systemctl "$SYSTEMCTL_SCOPE" show -P TimersCalendar "$TRIGGER_UNIT" 2>/dev/null \
        | sed -n 's/.*OnCalendar=\(.*\) ; next_elapse=.*/\1/p'
}

# "<started>\t<host>" of the newest successful run in the history, if any.
last_success() {
    [[ -f "$HISTORY_FILE" ]] || return 0
    awk '/"exit_code":[[:space:]]*0[,}]/ { line = $0 } END { if (line == "") exit
        started = line; sub(/.*"started":"/, "", started); sub(/".*/, "", started)
        host = ""; if (line ~ /"host":"/) { host = line; sub(/.*"host":"/, "", host); sub(/".*/, "", host) }
        print started "\t" host }' "$HISTORY_FILE"
}

# Epoch of the first elapse of any of the calendars after epoch $1.
next_elapse_after() {
    local base="$1" when first=""
    local -a calendars=()
    mapfile -t calendars < <(trigger_calendars)
    (( ${#calendars[@]} )) || return 1
    while IFS= read -r when; do
        when=$(date -u -d "$when" +%s 2>/dev/null) || continue
        [[ -z "$first" ]] || (( when < first )) && first="$when"
    done < <(systemd-analyze calendar --iterations=1 --base-time="@$base" "${calendars[@]}" 2>/dev/null \
        | sed -n 's/^[[:space:]]*(in UTC): //p')
    [[ -n "$first" ]] && echo "$first"
}

if [[ -n "${TRIGGER_UNIT:-}" ]]; then
    IFS=$'\t' read -r LAST_STARTED LAST_HOST < <(last_success) || true
    if [[ -n "${LAST_STARTED:-}" ]] \
            && LAST_EPOCH=$(date -d "$LAST_STARTED" +%s 2>/dev/null) \
            && NEXT_DUE=$(next_elapse_after "$LAST_EPOCH") \
            && (( NEXT_DUE > $(date +%s) )); then
        MSG="skipped: the run started $LAST_STARTED${LAST_HOST:+ on $LAST_HOST} covers this slot, next due $(date -d "@$NEXT_DUE" -Iseconds)"
        echo "=== $(date -Iseconds) === $TRIGGER_UNIT $MSG ===" >> "$LOG_FILE"
        echo "$JOB_NAME: $MSG"
        FINISHED=1
        exit 0
    fi
fi

# --- job queue: wait for exclusive lock ---
# Only one backup runs at a time. Others wait in FIFO order.

# This run supersedes any postponed one; a failed preflight above keeps the
# marker so the next start tries again.
rm -f "$DEFERRED_FILE"

# The shared queue lock belongs to root and is only readable: flock needs an
# open file, not a writable one.
if [[ -e "$LOCK_FILE" ]]; then
    exec 9<"$LOCK_FILE"
else
    exec 9>"$LOCK_FILE"
fi
if ! flock -n 9 2>/dev/null; then
    write_status "queued"
    notify "⏳ $JOB_NAME" "Waiting for another backup to finish"
    # Blocking wait in the background: a foreground command would hold off the
    # SIGTERM trap until the lock came free. The lock belongs to the open file
    # description, which the child shares with us, so it outlives the child.
    flock 9 &
    FLOCK_PID=$!
    while :; do
        FLOCK_RC=0
        wait "$FLOCK_PID" 2>/dev/null || FLOCK_RC=$?
        handle_signals
        # >128 with flock still alive: a trapped signal cut the wait short
        (( FLOCK_RC > 128 )) && kill -0 "$FLOCK_PID" 2>/dev/null && continue
        break
    done
    FLOCK_PID=""
    if (( FLOCK_RC != 0 )); then
        ERROR_MSG="Could not acquire the job queue lock (flock exit $FLOCK_RC)"
        write_status "error"
        notify "✖ $JOB_NAME" "$ERROR_MSG"
        FINISHED=1
        exit 1
    fi
fi
# Lock acquired — reset start time to now (excludes queue wait)
START_TIME="$(date -Iseconds)"
START_EPOCH="$(date +%s)"

# --- rotate log ---

if [[ -f "$LOG_FILE" ]] && (( $(stat -c%s "$LOG_FILE" 2>/dev/null || echo 0) > 16777216 )); then
    mv -f "$LOG_FILE" "$LOG_FILE.prev"
fi

# --- rsync engine ---

# Every tick while rsync runs: turn its progress into the status file.
rsync_tick() {
    [[ "$IS_PAUSED" -eq 0 ]] || return 0
    read_progress || true
    if (( ! COMPARED )) && [[ -r "/proc/$CHILD_PID/io" ]]; then
        SCAN_READ=$(format_bytes "$(awk '/^read_bytes:/ {print $2}' "/proc/$CHILD_PID/io" 2>/dev/null || echo 0)")
    fi
    write_active_status
}

# Builds rsync's arguments and runs it — again from the start after a suspend.
run_rsync() {
    # Delete mode: before (default), during, after, or disabled
    DELETE_MODE="${BACKUP_SYNC_DELETE_MODE:-before}"
    DELETE_ARG=""
    case "$DELETE_MODE" in
        before)  DELETE_ARG="--delete-before" ;;
        during)  DELETE_ARG="--delete-during" ;;
        after)   DELETE_ARG="--delete-after" ;;
        disabled) DELETE_ARG="" ;;
        *)       DELETE_ARG="--delete-before" ;;
    esac

    RSYNC_ARGS=(
        -a
        # What the progress filter counts: see "progress" above.
        --info=progress2,flist2
        --debug=del2
        --itemize-changes --itemize-changes
        --no-inc-recursive
        --human-readable
        --outbuf=L
        # The job's own state in the destination: excluded, so --delete leaves it
        # alone. Unanchored, so another job's state inside the source (a job whose
        # destination lies within this one's source) is not mirrored either.
        --exclude=.mirror-backup/
    )

    [[ -n "$DELETE_ARG" ]] && RSYNC_ARGS+=("$DELETE_ARG")

    if [[ -n "$EXCLUDE_FILE" && -f "$EXCLUDE_FILE" ]]; then
        RSYNC_ARGS+=(--exclude-from="$EXCLUDE_FILE")
    fi

    if [[ "$ARCHIVE_DAYS" -gt 0 ]]; then
        ARCHIVE_DIR="$DST/.archive/$(date +%Y-%m-%d_%H%M%S)"
        # The archive lives inside the destination, so rsync sees it as extraneous.
        # Without this exclude it does not delete it — it *backs it up*, moving the
        # previous archive into the new one and nesting them one level deeper every
        # run (backup-secondary reached four levels before this was spotted, and the
        # maxdepth-1 pruning below could never reach the buried ones).
        RSYNC_ARGS+=(--backup "--backup-dir=$ARCHIVE_DIR" --exclude=/.archive/)
    fi

    # --- optional rsync features (env vars set by systemd service) ---

    # Bandwidth limit (KB/s)
    if [[ -n "${BACKUP_SYNC_BWLIMIT:-}" && "${BACKUP_SYNC_BWLIMIT:-0}" -gt 0 ]]; then
        RSYNC_ARGS+=("--bwlimit=${BACKUP_SYNC_BWLIMIT}")
    fi

    # Compression
    [[ "${BACKUP_SYNC_COMPRESS:-0}" == "1" ]] && RSYNC_ARGS+=(--compress)

    # Checksum-based comparison instead of time+size
    [[ "${BACKUP_SYNC_CHECKSUM:-0}" == "1" ]] && RSYNC_ARGS+=(--checksum)

    # Preserve hard links
    [[ "${BACKUP_SYNC_HARD_LINKS:-0}" == "1" ]] && RSYNC_ARGS+=(--hard-links)

    # Preserve extended attributes
    [[ "${BACKUP_SYNC_XATTRS:-0}" == "1" ]] && RSYNC_ARGS+=(--xattrs)

    # Preserve ACLs
    [[ "${BACKUP_SYNC_ACLS:-0}" == "1" ]] && RSYNC_ARGS+=(--acls)

    # Resume partial transfers
    [[ "${BACKUP_SYNC_PARTIAL:-0}" == "1" ]] && RSYNC_ARGS+=(--partial)

    # Skip newer files on destination
    [[ "${BACKUP_SYNC_UPDATE:-0}" == "1" ]] && RSYNC_ARGS+=(--update)

    # Max file size
    if [[ -n "${BACKUP_SYNC_MAX_SIZE:-}" ]]; then
        RSYNC_ARGS+=("--max-size=${BACKUP_SYNC_MAX_SIZE}")
    fi

    # Min file size
    if [[ -n "${BACKUP_SYNC_MIN_SIZE:-}" ]]; then
        RSYNC_ARGS+=("--min-size=${BACKUP_SYNC_MIN_SIZE}")
    fi

    read -r EST_FILES EST_DIRS < <(previous_totals) || true
    EST_FILES=${EST_FILES:-0} EST_DIRS=${EST_DIRS:-0}

    while :; do
        LAST_PCT=0 LAST_SPEED="" LAST_ETA="" CURRENT_FILE="" SCAN_READ=""
        FILES_XFRD=0 FILES_TOTAL=0 FILES_REMAINING=0 DIRS_SEEN=0 COMPARED=0
        PHASE="" PHASE_DONE=0 PHASE_TOTAL=0 PHASE_ESTIMATED=0 PROGRESS_EOF=0
        TRANSFER_SEQ="" TRANSFER_EPOCH=0
        write_status "scanning"
        echo "=== $START_TIME === $JOB_NAME: $SRC → $DST ===" >> "$LOG_FILE"

        rm -f "$PROGRESS_FILE"
        rsync "${RSYNC_ARGS[@]}" "$SRC" "$DST" \
            > >(stdbuf -oL tr '\r' '\n' | "${PROGRESS_FILTER[@]}") \
            2>> "$LOG_FILE" &
        CHILD_PID=$!
        echo "$$ $CHILD_PID" > "$PID_FILE"
        acquire_inhibitor
        if (( WAS_PAUSED )); then
            pause_child   # the user's pause outlives the suspend
            WAS_PAUSED=0
        fi

        supervise "$CHILD_PID" rsync_tick && break

        stop_child_for_suspend
        # Start over rather than resume: rsync needs a fresh file list anyway, and
        # the pass after wake is what the history entry and the log should show.
        START_TIME="$(date -Iseconds)"
        START_EPOCH="$(date +%s)"
        notify "🔄 $JOB_NAME" "Restarting after wake"
    done

    # The filter writes its last snapshot once rsync's output has ended.
    for _ in {1..50}; do
        if read_progress && (( PROGRESS_EOF )); then break; fi
        sleep 0.1
    done

    # Capture rsync exit code without tripping `set -e` on non-zero (e.g. 23 = partial)
    RSYNC_EXIT=0
    wait "$CHILD_PID" 2>/dev/null || RSYNC_EXIT=$?

    # --- archive cleanup ---

    prune_archive() {
        # gio trash cannot be used here: this runs unattended, the destination may be
        # a NAS mount, and an expired archive is by definition already a second copy.
        find "$DST/.archive" -mindepth 1 -maxdepth 1 -type d -mtime "+$ARCHIVE_DAYS" \
            -exec rm -rf {} + 2>/dev/null || true
        rmdir "$DST/.archive" 2>/dev/null || true
    }

    if [[ "$ARCHIVE_DAYS" -gt 0 && -d "$DST/.archive" ]]; then
        PHASE=pruning PHASE_DONE=0 PHASE_TOTAL=0 PHASE_ESTIMATED=0
        LAST_PCT=0 LAST_SPEED="" LAST_ETA="" CURRENT_FILE=""
        write_status "running"
        # The destination can be a FUSE mount too, so pruning runs under the same
        # suspend guard; stopped halfway, it simply runs again after wake.
        while :; do
            prune_archive &
            PRUNE_PID=$!
            supervise "$PRUNE_PID" no_tick && break
            stop_tree "$PRUNE_PID"
            wait_for_wake
            acquire_inhibitor
        done
        PRUNE_PID=""
    fi
}

# rsync's exit code into FINAL_STATE, ERROR_MSG, HISTORY_EXIT and ENGINE_EXIT.
finish_rsync() {
    if [[ "$RSYNC_EXIT" -eq 0 || "$RSYNC_EXIT" -eq 23 || "$RSYNC_EXIT" -eq 24 ]]; then
        LAST_PCT=100
        CURRENT_FILE=""
        if [[ "$RSYNC_EXIT" -ne 0 ]]; then
            ERROR_MSG="Partial transfer (exit $RSYNC_EXIT) — some files skipped"
        else
            ERROR_MSG=""
        fi
        HISTORY_EXIT=0  # tolerate 23/24 as success in history
        RSYNC_EXIT=0
    else
        ERROR_MSG=$(tail -5 "$LOG_FILE" 2>/dev/null | grep -v '^===' | head -3 | tr '\n' ' ' | sed 's/  */ /g; s/^ *//; s/ *$//') || true
        FINAL_STATE="error"
        HISTORY_EXIT="$RSYNC_EXIT"
        DIRS_SEEN=0   # a comparison cut short counted only part of them
    fi
    ENGINE_EXIT=$RSYNC_EXIT
    HISTORY_EXTRA=""
}

# --- restic engine ---
#
# A restic run is a row of steps, each a phase of its own in the status:
#
#   prepare   the job's pre-command (a system job writes the metadata a bare
#             metal restore needs), then `restic unlock`: locks left behind by
#             a run that was killed, never a live one
#   snapshot  mode backup: `restic backup` of the listed paths, one file system
#             each (`--one-file-system`, every listed path counts on its own)
#   copy      mode copy: `restic copy` of this host's snapshots from the source
#             job's repository
#   forget    retention (BACKUP_SYNC_RESTIC_KEEP), for this host's snapshots only
#   prune     drops the data no snapshot needs any more — every
#             BACKUP_SYNC_RESTIC_PRUNE_DAYS days, it rewrites packs
#   verify    `restic check` reading a subset of the data — every
#             BACKUP_SYNC_RESTIC_CHECK_DAYS days
#
# Each step runs under the suspend guard like rsync: a suspend stops it (restic
# leaves no lock behind on SIGTERM; `unlock` clears one a SIGKILL left) and the
# step runs again after wake. A failed step ends the run.

RESTIC_STEP_FAILED=""   # phase of the step that failed
STEP_EXIT=0
SNAPSHOT_EXIT=0

restic_tick() {
    [[ "$IS_PAUSED" -eq 0 ]] || return 0
    read_restic_progress || true
    write_status "running"
}

# run_step <phase> <command…>: one step. Its stdout goes through the progress
# filter, its stderr into the log; with STEP_LOG_STDOUT=1 (a pre-command, not
# restic) the stdout goes into the log too. Sets STEP_EXIT.
STEP_LOG_STDOUT=0
run_step() {
    local phase="$1"
    shift
    while :; do
        PHASE="$phase" PHASE_UNIT="" PHASE_DONE=0 PHASE_TOTAL=0 PHASE_ESTIMATED=0 PROGRESS_EOF=0
        LAST_PCT=0 LAST_SPEED="" LAST_ETA="" CURRENT_FILE="" FILES_XFRD=0 FILES_TOTAL=0 FILES_REMAINING=0
        rm -f "$PROGRESS_FILE"
        echo "=== $(date -Iseconds) === $phase: $1 ===" >> "$LOG_FILE"
        write_status "running"
        if (( STEP_LOG_STDOUT )); then
            "$@" >> "$LOG_FILE" 2>&1 &
        else
            "$@" > >(stdbuf -oL tr '\r' '\n' | "${AWK_LINES[@]}" -v "out=$PROGRESS_FILE" \
                -v "summary=$SUMMARY_FILE" -v "logfile=$LOG_FILE" -v "phase=$phase" "$RESTIC_PROGRESS_AWK") \
                2>> "$LOG_FILE" &
        fi
        CHILD_PID=$!
        echo "$$ $CHILD_PID" > "$PID_FILE"
        acquire_inhibitor
        if (( WAS_PAUSED )); then
            pause_child   # the user's pause outlives the suspend
            WAS_PAUSED=0
        fi

        supervise "$CHILD_PID" restic_tick && break

        stop_child_for_suspend
        notify "🔄 $JOB_NAME" "Restarting after wake"
    done

    if (( ! STEP_LOG_STDOUT )); then
        # The filter writes its last snapshot once the output has ended.
        for _ in {1..50}; do
            if read_restic_progress && (( PROGRESS_EOF )); then break; fi
            sleep 0.1
        done
    fi
    STEP_EXIT=0
    wait "$CHILD_PID" 2>/dev/null || STEP_EXIT=$?
    CHILD_PID=""
    echo "=== $(date -Iseconds) === $phase: exit $STEP_EXIT ===" >> "$LOG_FILE"
}

# When prune or check ($1) last ran, from the destination's maintenance.json.
maintenance_last() {
    [[ -f "$MAINTENANCE_FILE" ]] || return 0
    sed -n "s/.*\"$1\": *\"\\([^\"]*\\)\".*/\\1/p" "$MAINTENANCE_FILE" | head -n 1
}

# Is the step $1 (prune / check) due, every $2 days? An hour of slack keeps a
# daily schedule that runs a little earlier than last time from slipping a day.
maintenance_due() {
    local last
    (( $2 > 0 )) || return 1
    last=$(maintenance_last "$1")
    [[ -n "$last" ]] || return 0
    last=$(date -d "$last" +%s 2>/dev/null) || return 0
    (( $(date +%s) - last >= $2 * 86400 - 3600 ))
}

maintenance_done() {
    local prune check
    prune=$(maintenance_last prune) check=$(maintenance_last check)
    case "$1" in
        prune) prune=$(date -Iseconds) ;;
        check) check=$(date -Iseconds) ;;
    esac
    printf '{"prune": "%s", "check": "%s"}\n' "$prune" "$check" > "$MAINTENANCE_FILE.tmp"
    mv -f "$MAINTENANCE_FILE.tmp" "$MAINTENANCE_FILE"
}

# The step failed: note which, and stop the run.
step_failed() {
    RESTIC_STEP_FAILED="$1"
}

run_restic() {
    local -a keep=() backup_args=()
    export RESTIC_REPOSITORY="$DST_DIR/repo"
    export RESTIC_PROGRESS_FPS="${RESTIC_PROGRESS_FPS:-0.5}"
    # A system unit gets CacheDirectory=mirror-backup; without a cache restic
    # reads the whole index from the (slow, possibly remote) repository.
    if [[ -z "${RESTIC_CACHE_DIR:-}" && -n "${CACHE_DIRECTORY:-}" ]]; then
        export RESTIC_CACHE_DIR="${CACHE_DIRECTORY%%:*}/restic"
    fi
    if [[ "$RESTIC_MODE" == copy ]]; then
        export RESTIC_FROM_REPOSITORY="$SRC_DIR/repo"
        export RESTIC_FROM_PASSWORD_FILE="${RESTIC_FROM_PASSWORD_FILE:-$RESTIC_PASSWORD_FILE}"
    fi
    echo "=== $START_TIME === $JOB_NAME: ${SRC_LABEL:-$SRC} → $RESTIC_REPOSITORY ===" >> "$LOG_FILE"

    if [[ -n "$PRE_COMMAND" ]]; then
        STEP_LOG_STDOUT=1
        run_step prepare "$PRE_COMMAND"
        STEP_LOG_STDOUT=0
        (( STEP_EXIT == 0 )) || { step_failed prepare; return 0; }
    fi
    run_step prepare restic unlock
    (( STEP_EXIT == 0 )) || { step_failed prepare; return 0; }

    if [[ "$RESTIC_MODE" == backup ]]; then
        backup_args=(--json --one-file-system --exclude-caches --host "$RESTIC_HOST"
            # the repository itself, should it lie below a listed path
            --exclude "$DST_DIR")
        [[ -n "$EXCLUDE_FILE" && -f "$EXCLUDE_FILE" ]] && backup_args+=(--exclude-file "$EXCLUDE_FILE")
        rm -f "$SUMMARY_FILE"
        run_step snapshot restic backup "${backup_args[@]}" -- "${RESTIC_PATHS[@]}"
        SNAPSHOT_EXIT=$STEP_EXIT
        # 3: some files could not be read — the snapshot exists without them.
        (( STEP_EXIT == 0 || STEP_EXIT == 3 )) || { step_failed snapshot; return 0; }
    else
        run_step copy restic copy --host "$RESTIC_HOST"
        (( STEP_EXIT == 0 )) || { step_failed copy; return 0; }
    fi

    if [[ -n "$RESTIC_KEEP" ]]; then
        read -ra keep <<< "$RESTIC_KEEP"
        # Grouped by host alone: a path added to or dropped from the list must
        # not start a group of its own that retention never thins.
        run_step forget restic forget --host "$RESTIC_HOST" --group-by host "${keep[@]}"
        (( STEP_EXIT == 0 )) || { step_failed forget; return 0; }
    fi
    if maintenance_due prune "$RESTIC_PRUNE_DAYS"; then
        run_step prune restic prune --max-unused 10%
        (( STEP_EXIT == 0 )) || { step_failed prune; return 0; }
        maintenance_done prune
    fi
    if maintenance_due check "$RESTIC_CHECK_DAYS"; then
        run_step verify restic check --read-data-subset "$RESTIC_CHECK_SUBSET"
        (( STEP_EXIT == 0 )) || { step_failed verify; return 0; }
        maintenance_done check
    fi
    return 0
}

# What went wrong in the failed step: restic's own words where it gave them.
restic_error_message() {
    local message
    case "$STEP_EXIT" in
        10) echo "Repository not found: $RESTIC_REPOSITORY"; return ;;
        11) echo "Repository is locked by another restic process"; return ;;
        12) echo "Wrong repository password ($RESTIC_PASSWORD_FILE)"; return ;;
    esac
    message=$(tail -n 200 "$LOG_FILE" 2>/dev/null | awk '
        /"message_type":"exit_error"/ && match($0, /"message":"([^"\\]|\\.)*"/) {
            m = substr($0, RSTART + 11, RLENGTH - 12) }
        /^Fatal: / { m = substr($0, 8) }
        END { print m }') || true
    if [[ -z "$message" ]]; then
        message=$(tail -n 6 "$LOG_FILE" 2>/dev/null | grep -v '^===' | tail -n 3 | tr '\n' ' ' \
            | sed 's/  */ /g; s/^ *//; s/ *$//') || true
    fi
    echo "${message:-exit $STEP_EXIT}"
}

# A number from the backup's summary message.
summary_field() {
    local value=""
    [[ -f "$SUMMARY_FILE" ]] && value=$(grep -o "\"$1\":[^,}]*" "$SUMMARY_FILE" | head -n 1 | cut -d: -f2 | tr -d '"')
    printf '%s' "${value:-0}"
}

# The steps' outcome into FINAL_STATE, ERROR_MSG, HISTORY_EXIT and ENGINE_EXIT.
finish_restic() {
    local label snapshot_id copied
    ENGINE_EXIT=0 HISTORY_EXIT=0 ERROR_MSG=""
    if [[ -n "$RESTIC_STEP_FAILED" ]]; then
        case "$RESTIC_STEP_FAILED" in
            prepare)  label="Preparation" ;;
            snapshot) label="Backup" ;;
            copy)     label="Copy" ;;
            forget)   label="Retention" ;;
            prune)    label="Prune" ;;
            verify)   label="Repository check" ;;
        esac
        ERROR_MSG="$label failed: $(restic_error_message)"
        FINAL_STATE="error"
        ENGINE_EXIT=$STEP_EXIT HISTORY_EXIT=$STEP_EXIT
        (( ENGINE_EXIT )) || ENGINE_EXIT=1 HISTORY_EXIT=1
    else
        LAST_PCT=100
        CURRENT_FILE=""
        (( SNAPSHOT_EXIT == 3 )) && ERROR_MSG="Some files could not be read — the snapshot was taken without them"
    fi

    HISTORY_EXTRA=",\"engine\":\"restic\""
    if [[ "$RESTIC_MODE" == backup ]]; then
        FILES_TOTAL=$(summary_field total_files_processed)
        FILES_XFRD=$(( $(summary_field files_new) + $(summary_field files_changed) ))
        snapshot_id=$(summary_field snapshot_id)
        [[ "$snapshot_id" == 0 ]] && snapshot_id=""
        HISTORY_EXTRA+=$(printf ',"snapshot_id":"%s","files_new":%d,"files_changed":%d,"data_added":%d,"bytes_total":%d' \
            "$snapshot_id" "$(summary_field files_new)" "$(summary_field files_changed)" \
            "$(summary_field data_added)" "$(summary_field total_bytes_processed)")
    else
        copied=$(awk -v marker="=== ${START_TIME} ===" '
            !found { if (index($0, marker) == 1) found = 1; next }
            /^snapshot [0-9a-f]+ saved, copied from source snapshot/ { n++ }
            END { print n + 0 }' "$LOG_FILE" 2>/dev/null) || copied=0
        FILES_XFRD=0 FILES_TOTAL=0
        HISTORY_EXTRA+=",\"snapshots_copied\":${copied:-0}"
    fi
    rm -f "$SUMMARY_FILE"
}

# --- go ---

echo "$$ " > "$PID_FILE"
notify "🔄 $JOB_NAME" "${SRC_LABEL:-$SRC} → $DST"
start_sleep_guard
"run_$ENGINE"
stop_sleep_guard

# --- finish: classify outcome ---

FINISHED=1
FINAL_STATE="idle"
"finish_$ENGINE"
PHASE="" PHASE_UNIT="" PHASE_DONE=0 PHASE_TOTAL=0 PHASE_ESTIMATED=0 LAST_SPEED="" LAST_ETA=""

# --- write history entry (must happen before streak compute) ---

FINISH_TIME="$(date -Iseconds)"
FINISH_EPOCH="$(date +%s)"
DURATION_SEC=$(( FINISH_EPOCH - START_EPOCH ))
printf '{"started":"%s","finished":"%s","duration_sec":%d,"exit_code":%d,"files_transferred":%d,"files_total":%d,"dirs_total":%d,"error":"%s","host":"%s"%s}\n' \
    "$START_TIME" "$FINISH_TIME" "$DURATION_SEC" "$HISTORY_EXIT" \
    "${FILES_XFRD:-0}" "${FILES_TOTAL:-0}" "${DIRS_SEEN:-0}" \
    "$(json_escape "${ERROR_MSG:-}")" "$(json_escape "$HOST")" "${HISTORY_EXTRA:-}" \
    >> "$HISTORY_FILE"

# --- compute consecutive failure streak + detect suggested excludes ---

CONSECUTIVE_FAILURES=$(compute_failure_streak "$HISTORY_FILE")
SUGGESTED_EXCLUDES_JSON=$(suggest_excludes_from_log | to_json_array)

# --- write final status (with streak + suggestions) and notify ---

write_status "$FINAL_STATE"

if [[ "$FINAL_STATE" == "idle" ]]; then
    if [[ -n "$ERROR_MSG" ]]; then
        notify "✔ $JOB_NAME" "Backup completed with warnings"
    else
        notify "✔ $JOB_NAME" "Backup completed"
    fi
elif [[ "$RESTIC_STEP_FAILED" == verify ]]; then
    # The repository itself is damaged: no streak to wait for.
    notify "✖ $JOB_NAME: repository check failed" "${ERROR_MSG}" 2 0
elif (( CONSECUTIVE_FAILURES >= FAILURE_STREAK_THRESHOLD )); then
    # Persistent failure — escalate to critical urgency, sticky until dismissed
    notify "✖ $JOB_NAME failed ${CONSECUTIVE_FAILURES}× in a row" \
        "${ERROR_MSG:-Backup failed (exit $HISTORY_EXIT)}" 2 0
else
    notify "✖ $JOB_NAME" "Backup failed (exit $HISTORY_EXIT)"
fi

rm -f "$PROGRESS_FILE"
echo "=== $(date -Iseconds) === finished (exit $ENGINE_EXIT) ===" >> "$LOG_FILE"

# --- rotate history (keeps file from growing unbounded) ---

rotate_history "$HISTORY_FILE" "$HISTORY_KEEP"

exit "$ENGINE_EXIT"
